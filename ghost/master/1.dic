//曲リストに追加できる音楽ファイルの拡張子か（_argv[0] は . 付きの小文字の拡張子）
□音楽ファイルの拡張子か {
(ASEARCH(_argv[0],'.mid','.mp3','.wav','.wma','.ogg','.m4a','.aac','.flac','.opus')) != -1
}

絶対パス変換 {
//相対パスなら絶対パスになおす
if "..\..\..\sound_file\" _in_ _argv[0] {
	REPLACE(_argv[0],"..\..\..\sound_file\","%(○現在パス)sound_file\")
	}
else {_argv[0]}
}

//曲ファイルのタグをSSP本体（SAORI over DirectSSTP の internal_file / MediaInfo）で読む
//再生していない曲でも、ファイルをロードせずに読める
//返値：(title, artist, album, genre, year, duration, comment) の配列。取れなかった値は空
□メディア情報 {
_v = ('','','','','','','')
//使えない（旧SSP、SSP以外）ときは LIB.STATUSCODE が変わらないので、先に空にしておく
LIB.STATUSCODE = ''
void FUNCTIONEX('internal_file','MediaInfo',_argv[0],'title','artist','album','genre','year','duration','comment')
//ファイルが無いなどの失敗（400/500）や使えないときは空のまま
if STRSTR(LIB.STATUSCODE,'200',0) == 0 {
	for _i = 0 ; _i < 7 ; _i++ {
		//値の中の改行は 0x01 になって届く
		_v[_i] = REPLACE(TOSTR(valueex[_i]), CHR(1), ' ')
		}
	}
_v
}


