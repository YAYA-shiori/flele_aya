%(REPLACE(○weirdsリスト,ASC(4),'フォルダを開く'))/

%(REPLACE(○weirdsリスト,ASC(4),'削除'))/

"
	}
	else {"%(ASC(1))%(ASC(1))　　 no data%(ASC(1))Dummy%(ASC(2))"}
--
"%(ASC(1))%(ASC(1))%(ASC(1))Separator%(ASC(2))"
--
	□weirds再生法("ランダムでエンドレス","ランダムで連続再生","random")
--
	□weirds再生法("リスト順にエンドレス","seq_loop")
--
	□weirds再生法("リスト順に一周だけ","seq_one")
--
	□weirds再生法("一曲を一度だけ","one")
--
	□weirds再生法("同じ曲をエンドレス","loop")
--
}





□weirdsリスト生成 {
ERASEVAR("○weirdsリスト")
//○曲リスト配列の各要素値を順番に取り出し
_c=0
  //25曲以下ならフォルダにいれない
  if ○曲の数<=25 {
	foreach ○曲リスト ; _i {
	// ファイル名を曲名に
	_曲名 = ((SPLITPATH (_i))[2]) + ((SPLITPATH (_i))[3])

	○weirdsリスト = ○weirdsリスト + ASC(4) + ASC(1) + ASC(1) + _曲名 + ASC(1) + "Event" + ASC(1) + "On_weirds曲%(ASC(4))" + ASC(1) + _c + ASC(2)
	_c++
	}
  }
  else {
	foreach ○曲リスト ; _i {
	// ファイル名を曲名に
	_曲名 = ((SPLITPATH (_i))[2]) + ((SPLITPATH (_i))[3])
	_フォルダ = (_c/25)*25+25
	○weirdsリスト = ○weirdsリスト + ASC(4) + "\" + "～ " + _フォルダ + ASC(1) + ASC(1) + _曲名 + ASC(1) + "Event" + ASC(1) + "On_weirds曲%(ASC(4))" + ASC(1) + _c + ASC(2)
	_c++

	}
  }


○曲リスト更新=0
}

On_weirds曲再生 {
○指定曲番号 = TOINT(reference0)+1
□曲ランダム再生
}

On_曲ランダム再生 {
□曲ランダム再生
}

On_weirds曲削除 {
_idx = TOINT(reference0)
if _idx < 0 || _idx >= ○曲の数 {
	return
	}
_path = ○曲リスト[_idx]
_script = ''
//演奏中（一時停止中も含む）の曲なら止める
if ○演奏中曲パス == _path {
	ERASEVAR('○演奏中曲パス')
	_script = □演奏ストップ
	}
//前にある曲を消したら演奏中の曲番号を詰める
elseif _idx < ○演奏中曲No - 1 {
	○演奏中曲No = ○演奏中曲No - 1
	}
//ダウンロード曲だったらファイルも削除（再生中で消せなければ止まってから消す）
_d = ASEARCH(_path,○ダウンロード曲リスト)
if _d != -1 {
	void □ファイル削除予約(_path)
	if (ARRAYSIZE(○ダウンロード曲リスト))<=1 {○ダウンロード曲リスト = IARRAY}
	else {○ダウンロード曲リスト[_d] = IARRAY }
	}
if ○曲の数<=1 {○曲リスト = IARRAY}
else {○曲リスト[_idx] = IARRAY}
○曲リスト更新=1
void □曲名ウィンドウONなら表示
_script + □削除待ち処理予約
}

On_曲リストクリア {
"\0\v"
--
□曲リストクリア
}

On_weirds曲情報 {
○path = ○曲リスト[reference0]
○No = reference0+1
□weirds曲情報
}

