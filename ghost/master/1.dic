/// url drop ///////////////////////////////////////////////////

OnURLQuery {

if "audio" _in_ reference2 {
	○URL=reference0
	□URLから曲ダウンロード
	}

}

□URLから曲ダウンロード {

	//　URLが音楽ファイルかどうか確認
	_拡張子 = TOLOWER ((SPLITPATH (○URL))[3])
	if □音楽ファイルの拡張子か(_拡張子) {
	○DL開始 = 0
	○DL成功 = 0
	○URL = reference0
		"\0"
	--
	○上書き曲DL=0
		_file = ((SPLITPATH (○URL))[2])+((SPLITPATH (○URL))[3])
file=_file
		if (FATTRIB("..\..\sound_file\%(_file)")) != -1 {
			"\b[0]既に同じ名前のファイルがダウンロードされています。\w5\n上書きしますか？\w4\n[half]/
			\n　　　 \q[OK,□上書き曲ダウンロード]｜\q[NG,□close]/
			\e"
		}
		else {□曲ダウンロード開始}
	}
}

□上書き曲ダウンロード {
	○上書き曲DL=1
	_ファイル名 = ((SPLITPATH (○URL))[2])+((SPLITPATH (○URL))[3])
	_script = ''
	//上書きする曲を演奏中なら止める（古いファイルは、再生が止まった後のダウンロード完了時に消す）
	if TOLOWER(○演奏中曲絶対パス) == TOLOWER("%(○現在パス)sound_file\%(_ファイル名)") {
		_script = □演奏ストップ
		}
	_script + □曲ダウンロード開始
}


□曲ダウンロード開始 {
		○DL開始 = 1
		_file=(SPLITPATH(○URL))[2]+(SPLITPATH(○URL))[3]
		"\0\s[6]%(fcl)”%(_file)”%(def)\n now loading...\![execute,http-get,%(○URL),--timeout=40,--async=soundfile,--file=%(_file)]\e"
}


OnExecuteHTTPComplete {
	if reference0=="get"&& reference1=="soundfile" {

		_ファイル名 = ((SPLITPATH (○URL))[2])+((SPLITPATH (○URL))[3])
		//上書きのときは古いファイルを消してから移動する
		if ○上書き曲DL==1 {
			void FDEL ("..\..\sound_file\%(_ファイル名)")
		}
		//DLファイル移動
		_i=FMOVE ( "var\%(_ファイル名)","..\..\sound_file\" )
--
		if _i != 1 {
		○上書き曲DL=0
		"\0\s[6]%(_ファイル名)をsound_fileフォルダに移動できませんでした。\w9\w9\w9\w9%(○サーフェス)\e"
		}
		elseif ○上書き曲DL==1 {
		"\0\s[0]%(_ファイル名)を上書きしました。/
		\n\n[half]　　 \q[PLAY,□上書き曲再生]｜\q[CLOSE,□close]/
		\e"
		○上書き曲DL=0
		}
		else {
			_Filename = "..\..\..\sound_file\%(_ファイル名)"
		
				//　まだ入ってないならダウンロード曲リストに追加
				if (ASEARCH(_Filename,○ダウンロード曲リスト)) == -1 {
					if (ARRAYSIZE(○ダウンロード曲リスト))==0 {
					○ダウンロード曲リスト = _Filename
					}
					else {○ダウンロード曲リスト = (○ダウンロード曲リスト,_Filename)}
				}
				○DL成功 = 1
				//　ファイルパスをAllFilepathに保存し処理
				○AllFilepath = _Filename
				□ドロップファイル処理
		}
	}

}

OnExecuteHTTPFailure {"\0\s[6]\n\n　> Download-error\w9\w9\w9\w9%(○サーフェス)\b[-1]\e"}


□上書き曲再生 {
_ファイル名 = ((SPLITPATH (○URL))[2])+((SPLITPATH (○URL))[3])
_Filename = "..\..\..\sound_file\%(_ファイル名)"
○指定曲番号=(ASEARCH(_Filename,○曲リスト))+1
□曲ランダム再生
}

/// file drop //////////////////////////////////////////////////

OnDirectoryDrop
{
○ディレクトリ=0
○ディレクトリ=reference0
□ディレクトリドロップ処理
}

□ディレクトリパス調整 {
	if ○sender == "SSP" {○ディレクトリ = ○path}
	else {○ディレクトリ = ○path + "\"}
□ディレクトリドロップ処理
}


□ディレクトリドロップ処理 {
"\0\b[6]\b[-1]"
--
	//　ディレクトリに入ってるファイルを全て配列保存（カンマを含むファイル名が割れないよう、区切りを \x01 にする）
	○AllFilepath = SPLIT (FENUM (○ディレクトリ, CHR(1)), CHR(1))
	--
	□ドロップファイル処理
--
"\e"
}



OnFileDrop2 {
○path=0
○path=reference0
□ファイルがドロップされた
}

□ファイルがドロップされた {
"\0"
--
	//　ディレクトリかどうか判断
	if (FATTRIB (○path))[2] == 1 {
	○ディレクトリ=0
	○ディレクトリ=reference0
	□ディレクトリパス調整
	}
	
	//　ディレクトリじゃなかったらファイルとして処理
	else {
	○ディレクトリ = 0
	//　簡易配列を汎用配列へ変換
	○AllFilepath = SPLIT (○path, CHR(1))
	○path = (○AllFilepath[0])
	_拡張子 = TOLOWER ((SPLITPATH (○path))[3])
		// m3uを投げられた
	if _拡張子 == ".m3u" || _拡張子 == ".pls" {
		□プレイリスト処理
		}
		else {
		□ドロップファイル処理
		}
	}
--
"\e"
}



□ドロップファイル処理 {
	_ドロップファイル数 = ARRAYSIZE (○AllFilepath)
	_追加した曲数 = 0
	_既に入ってた曲数 = 0
//ドロップされたファイル配列の各要素値を順番に取り出し
foreach ○AllFilepath ; _Filename {
	//音楽ファイルかどうか拡張子で判断
	_拡張子 = TOLOWER ((SPLITPATH (_Filename))[3])
	if □音楽ファイルの拡張子か(_拡張子)
		{
		//ディレクトリパスが付いてなかったら付ける
		if ○ディレクトリ != 0 {_Filename = ○ディレクトリ + _Filename}
		
		//音楽ファイルならリストに入っているか判断(無い場合-1)
		if (ASEARCH(_Filename,○曲リスト)) == -1
			{
			//入っていない曲ならリストに追加
			if ○曲の数<=0 {○曲リスト = _Filename}
			else {○曲リスト = (○曲リスト,_Filename)}
			_追加した曲数++
			}
			//既に入ってた曲なら何もしないでカウント
			else { _既に入ってた曲数++ }
		}

	}
//曲追加した場合曲数報告
--
if _追加した曲数 >= 1 {
	○曲リスト更新=1
	□ヘルプメニュー消滅した
	--
	if ○曲の数 == 1 {○曲リスト = ○曲リスト[0]}
	"\b[0]\c%(○サーフェス)\s[0]%(_追加した曲数)曲追加。\w5\n曲リストには全%(○曲の数)曲入ってます。"
	--
	if _追加した曲数 == 1 {
	"\n\n[half]　　 \q[PLAY,□ドロップ曲再生]｜\q[CLOSE,□close]"
		}
	--
	"\w9\w9\w9\w9%(○サーフェス)"
	}
	
//曲追加できなかった
else {
	□ヘルプメニュー消滅した
	--
	//既に入ってた曲を1つ以上ドロップされた
	if _既に入ってた曲数 >0	{"\b[0]\s[0]その曲はもう既に入っています。\w9\w9\w9\w9%(○サーフェス)"}
	//音楽ファイルが1つも無かった
	else {"\b[0]\s[0]追加できる音楽ファイルがありませんでした。\w9\w9\w9\w9%(○サーフェス)"}
	}
//　セーブ
SAVEVAR
}

□ドロップ曲再生 {
○指定曲番号=○曲の数
□曲ランダム再生
}

□プレイリスト処理 {
_f=FOPEN (○path,"r")
_txt=0
_i=0
○AllFilepath = IARRAY
	while _txt != -1 && _i<5000 {
	_i++
	_txt = FREAD (○path)
	_d = _i-2
		//先頭にFile*=がついてたら削除
		if (STRSTR(_txt,"File%(_d)=",0))==0 {
		_txt = REPLACE(_txt, "File%(_d)=", "")
		}
		//先頭に#EXTM3Uや#EXTINFや[playlist]がついてなかったら○AllFilepathに追加
		if (STRSTR(_txt,"[playlist]",0))!=0 && (STRSTR(_txt,"#EXTM3U:",0))!=0 && (STRSTR(_txt,"#EXTINF:",0))!=0 && _txt!=-1 {
		○AllFilepath = (○AllFilepath,_txt)
		}
	}
FCLOSE (○path)
	if (ARRAYSIZE(○AllFilepath)) >=1 {
	□ドロップファイル処理
	}
}



/// music //////////////////////////////////////////////////////

// 演奏はSSP本体の \![sound] タグで行い、状態はsound系プロパティで本体に問い合わせる。
// SSPには曲のフルパス（絶対パス変換したもの）を渡し、同じ文字列を要素名として照合する。
// SSPは複数のサウンドを同時に鳴らせるので、曲を替えるときは必ず \![sound,stop] で止めてから鳴らす。
// イベントでスクリプトを返すと表示中のバルーンが閉じるので、裏で曲が替わるだけのときは先頭に \C を付ける。

//ボタン・キー・メニューから曲を演奏する（○指定曲番号があればその曲）
□曲ランダム再生 {
○ヘルプメニュー表示中=0
_指定 = 0
if (ISVAR("○指定曲番号"))==1 {
	_指定 = TOINT(○指定曲番号)
	ERASEVAR ("○指定曲番号")
	}
if ○曲の数 < 1 {
	return
	}
○連続エラー数 = 0
//曲を指定されたときは、その曲が無くても他の曲に替えない
if _指定 >= 1 && _指定 <= ○曲の数 {
	□曲番号を再生(_指定, 0)
	}
else {
	□曲番号を再生(□最初の曲番号, □スキップできる演奏法)
	}
}

//曲リストの_argv[0]番目（1始まり）の曲を演奏するスクリプトを返す
//_argv[1]が1なら、ファイルが見つからない曲を飛ばして次の曲を探す
□曲番号を再生 {
_n = ○曲の数
_no = TOINT(_argv[0])
_skip = TOINT(_argv[1])
if _n < 1 {
	return
	}
if _no < 1 || _no > _n { _no = 1 }

_開始前に止まっていた = (○演奏中 != 1)
_試行 = 0
_path = ''
while 1 {
	_path = □曲リストの曲(_no - 1)
	if _path != '' && (FATTRIB(絶対パス変換(_path))) != -1 {
		break
		}
	_試行++
	if _skip != 1 || _試行 >= _n {
		_no = 0
		}
	else {
		_no = □スキップ先の曲番号(_no)
		}
	if _no < 1 {
		break
		}
	}

//演奏できる曲が見つからなかった
if _no < 1 {
	_script = □演奏ストップ
	void □曲名ウィンドウONなら表示
	if _試行 >= 2 {
		_script + "\b[0]曲リストの曲が見つかりませんでした。\n[half]\nファイルを移動・削除していないか確かめてください。\e"
		}
	else {
		_file = ((SPLITPATH (_path))[2]) + ((SPLITPATH (_path))[3])
		_script + "\b[0]%(fcl)”\_!%(_file)\_!”%(def)が見つかりません。\n[half]\nファイルを移動・削除していないか確かめてください。\e"
		}
	return
	}

○演奏中曲No = _no
○演奏中曲パス = _path
○演奏中曲スキップ可 = _skip
○再生時間帯[hour] = TOINT((○再生時間帯[hour])+1)
○サーフェス = "\s[25]"
○演奏中 = 1
○一時停止中 = 0
○エラー後次の曲待ち = 0
○起動中演奏回++
// ファイル名を曲名にする
○演奏中曲名 = "%((SPLITPATH (○演奏中曲パス))[2])%((SPLITPATH (○演奏中曲パス))[3])"
// タグに曲名があれば曲名にする（取れなければファイル名のまま）
_m = □メディア情報(○演奏中曲絶対パス)
if _m[0] != '' {
	○演奏中曲名 = REPLACE(REPLACE(REPLACE(_m[0],"[","［"),"]","］"),"\","￥")
	}
//曲名ウィンドウ表示してたら曲名更新
void □曲名ウィンドウONなら表示

_script = "\![sound,stop]\![sound,play,%(□タグ引数(○演奏中曲絶対パス))]"
//演奏していない状態だったら歌サーフェスにする
if _開始前に止まっていた {
	_script += "\0\b[-1]\s[25]\e"
	}
//演奏中に曲が替わるだけなら、表示中のバルーン（ヘルプメニューなど）を消さないよう \C で続ける
else {
	_script = "\C" + _script
	}
_script
}

//曲リストの_argv[0]番目（0始まり）の曲のパス
□曲リストの曲 {
_i = TOINT(_argv[0])
if GETTYPE(○曲リスト) == 4 {
	○曲リスト[_i]
	}
//1曲だけのときは配列でなく文字列になっていることがある
elseif _i == 0 {
	○曲リスト
	}
else {
	''
	}
}

//演奏中の曲が曲リストの何番目か（1始まり）
□演奏中曲番号 {
_i = ASEARCH(○演奏中曲パス,○曲リスト)
if _i >= 0 {
	_i + 1
	}
else {
	TOINT(○演奏中曲No)
	}
}

//見つからない・再生できない曲を飛ばしてよい演奏法か
□スキップできる演奏法 {
if (ASEARCH(○演奏法,'one','loop')) == -1 { 1 }
else { 0 }
}

//最初に演奏する曲の番号（1始まり）
□最初の曲番号 {
_n = ○曲の数
if _n <= 1 || ○演奏法 == "seq_one" {
	1
	return
	}
//前回と違う曲をランダムに選ぶ
_cur = ASEARCH(○演奏中曲パス,○曲リスト)
_no = RAND(_n)
if _no == _cur {
	_no = (_no + 1 + RAND(_n - 1)) % _n
	}
_no + 1
}

//曲が最後まで演奏された後に演奏する曲の番号（0なら止める）
□次の曲番号 {
_no = TOINT(_argv[0])
_n = ○曲の数
if _n < 1 {
	0
	return
	}
case ○演奏法 {
	when "one" { 0 }
	when "loop" { _no }
	when "seq_one" {
		if _no >= _n { 0 }
		else { _no + 1 }
		}
	when "seq_loop" {
		if _no >= _n { 1 }
		else { _no + 1 }
		}
	others { □最初の曲番号 }
	}
}

//見つからない・再生できない曲を飛ばすときの次の曲の番号（0なら止める）
//ランダムでも全曲を一度ずつ試せるよう、リスト順に進める
□スキップ先の曲番号 {
_no = TOINT(_argv[0])
_n = ○曲の数
if _n < 1 {
	0
	}
elseif _no < _n {
	_no + 1
	}
elseif ○演奏法 == "seq_one" {
	0
	}
else {
	1
	}
}

//\![sound,play,～] などのタグに渡す引数（カンマを含むパスでも1つの引数になるよう""で囲む）
□タグ引数 {
_q = CHR(0x22)
_q + REPLACE(_argv[0], _q, _q + _q) + _q
}

//演奏中の曲の状態をSSP本体に問い合わせる
//返値：'playing'（演奏中）、'pause'（一時停止中）、'none'（開かれていない）、''（問い合わせできない）
□サウンド状態 {
_name = TOLOWER(○演奏中曲絶対パス)
if _name == '' {
	'none'
	return
	}
_count = GET_PROPERTY('currentghost.sound.count')
if SSTP.STATUS < 200 || SSTP.STATUS >= 300 {
	''
	return
	}
_count = TOINT(_count)
for _i = 0 ; _i < _count ; _i++ {
	if TOLOWER(GET_PROPERTY("currentghost.sound.index(%(_i)).name")) == _name {
		if TOINT(GET_PROPERTY("currentghost.sound.index(%(_i)).playing")) != 1 {
			'none'
			}
		elseif TOINT(GET_PROPERTY("currentghost.sound.index(%(_i)).pause")) == 1 {
			'pause'
			}
		else {
			'playing'
			}
		return
		}
	}
'none'
}

//演奏中の曲の状態（本体に問い合わせできないときは、ゴースト側で覚えている状態）
□演奏状態 {
_s = □サウンド状態
if _s == '' {
	if ○演奏中 == 1 { _s = 'playing' }
	elseif ○一時停止中 == 1 { _s = 'pause' }
	else { _s = 'none' }
	}
_s
}


□演奏一時停止 {
if ○曲の数 < 1 || (ISVAR('○演奏中曲パス')) == 0 {
	return
	}
○ヘルプメニュー表示中 = 0
_状態 = □演奏状態
if _状態 == 'playing' {
	○演奏中 = 0
	○一時停止中 = 1
	○サーフェス = "\s[0]"
	void □曲名ウィンドウONなら表示
	"\![sound,pause]\0\b[-1]\s[0]\e"
	}
elseif _状態 == 'pause' {
	○演奏中 = 1
	○一時停止中 = 0
	○サーフェス = "\s[25]"
	void □曲名ウィンドウONなら表示
	"\![sound,resume]\0\b[-1]\s[25]\e"
	}
//何も鳴っていない（起動した直後や、最後まで演奏し終わった後）なら前回の曲を演奏
else {
	○連続エラー数 = 0
	○演奏中 = 0
	○一時停止中 = 0
	□曲番号を再生(□演奏中曲番号, 0)
	}
}

//演奏中の曲を消したとき、曲リストを消したときなど
□演奏ストップ {
	○演奏中 = 0
	○一時停止中 = 0
	○エラー後次の曲待ち = 0
	○サーフェス = "\s[0]"
	"\![sound,stop]\0\s[0]"
}

//曲が最後まで演奏された（\![sound,stop] で止めたときは通知されない）
OnSoundStop {
	//自分が演奏している曲の通知だけを扱う
	if TOLOWER(reference0) != TOLOWER(○演奏中曲絶対パス) || (○演奏中 != 1 && ○一時停止中 != 1) {
		return
		}
	//再生ウィンドウが閉じられた
	if reference1 != "end" {
		○演奏中 = 0
		○一時停止中 = 0
		○サーフェス = "\s[0]"
		void □曲名ウィンドウONなら表示
		"\0\s[0]\e"
		return
		}
	○連続エラー数 = 0
	_next = □次の曲番号(□演奏中曲番号)
	if _next < 1 {
		○演奏中 = 0
		○一時停止中 = 0
		○サーフェス = "\s[0]"
		void □曲名ウィンドウONなら表示
		"\0\c\s[0]\e"
		}
	else {
		□曲番号を再生(_next, □スキップできる演奏法)
		}
}

//曲を再生できなかった（対応していない形式、壊れたファイルなど）
OnSoundError {
	if TOLOWER(reference2) != TOLOWER(○演奏中曲絶対パス) || ○演奏中 != 1 {
		return
		}
	_理由 = REPLACE(REPLACE(reference3, CHR(0xd), ''), CHR(0xa), ' ')
	if _理由 == '' { _理由 = "エラーコード %(reference1)" }
	_file = ((SPLITPATH (○演奏中曲パス))[2]) + ((SPLITPATH (○演奏中曲パス))[3])

	○演奏中 = 0
	○一時停止中 = 0
	○サーフェス = "\s[0]"
	○連続エラー数 = ○連続エラー数 + 1
	void □曲名ウィンドウONなら表示

	_script = "\0\b[0]\s[0]%(fcl)”\_!%(_file)\_!”%(def)を再生できませんでした。\n[half]\n\_!%(_理由)\_!"
	//連続再生中なら少し待って次の曲へ（全曲失敗したら止める）
	if ○演奏中曲スキップ可 == 1 && ○連続エラー数 < ○曲の数 {
		○エラー後次の曲待ち = 1
		"\![timerraise,3000,1,On_エラー後次の曲へ]" + _script + "\w9\w9\w9\w9%(○サーフェス)\e"
		}
	else {
		○連続エラー数 = 0
		_script + "\e"
		}
}

On_エラー後次の曲へ {
	//待っている間に別の曲を演奏したり止めたりしていたら何もしない
	if ○エラー後次の曲待ち != 1 || ○演奏中 == 1 {
		return
		}
	○エラー後次の曲待ち = 0
	_next = □スキップ先の曲番号(□演奏中曲番号)
	if _next >= 1 {
		□曲番号を再生(_next, 1)
		}
}

/// file delete ////////////////////////////////////////////////

// 演奏中のファイルは消せないことがあり、\![sound,stop] はスクリプトの実行時に非同期で処理される。
// 消せなかったファイルは○削除待ちファイルに入れ、On_削除待ちファイル処理で後から消す。

//ファイルを消す。消せなければ削除待ちにする。返値：1 消した（または既に無い）、0 削除待ちにした
□ファイル削除予約 {
_f = 絶対パス変換(_argv[0])
if (FATTRIB(_f)) == -1 {
	1
	return
	}
if FDEL(_f) == 1 {
	1
	return
	}
if (ASEARCH(_f,○削除待ちファイル)) == -1 {
	○削除待ちファイル = (○削除待ちファイル,_f)
	}
0
}

//削除待ちのファイルを消す。返値：消せずに残ったファイルの数
□削除待ちファイルを消す {
_残り = IARRAY
foreach ○削除待ちファイル ; _f {
	if _f == '' || (FATTRIB(_f)) == -1 {
		continue
		}
	if FDEL(_f) != 1 {
		_残り = (_残り,_f)
		}
	}
○削除待ちファイル = _残り
ARRAYSIZE(○削除待ちファイル)
}

//削除待ちのファイルがあれば、少し後に消すスクリプトを返す
□削除待ち処理予約 {
if (ARRAYSIZE(○削除待ちファイル)) > 0 {
	○削除再試行回数 = 0
	"\![timerraise,500,1,On_削除待ちファイル処理]"
	}
}

On_削除待ちファイル処理 {
	_残り = □削除待ちファイルを消す
	//まだ消せなければ少し待ってやり直す（それでも消せなければ次の起動時に消す）
	if _残り > 0 && ○削除再試行回数 < 10 {
		○削除再試行回数 = ○削除再試行回数 + 1
		//表示中のバルーンを消さないよう \C で続ける
		"\C\![timerraise,1000,1,On_削除待ちファイル処理]"
		}
	else {
		○削除再試行回数 = 0
		}
}

/// list clear /////////////////////////////////////////////////

□曲リストクリア {
_ダウンロード曲数 = (ARRAYSIZE(○ダウンロード曲リスト))
□ヘルプメニュー消滅した
--
　// 曲が一曲以上あれば実行
   if ○曲の数 >= 1 {
   	if _ダウンロード曲数 >= 1 {
	"\0\s[0]曲リスト全%(○曲の数)曲をクリア、\w3ダウンロード曲全%(_ダウンロード曲数)曲を削除します。\w5宜しいですか？"
	}
	else {
	"\0\s[0]曲リスト、\w2全%(○曲の数)曲をクリアします。\n\w4/
	宜しいですか？\w5\n[half]"
	}
--
"\n　　　 \q[OK,□曲リストクリア実行]｜\q[NG,□close]\e"
   }
   // 曲がなかった
   else { "\0\s[0]曲リストにはまだ何もありません。\e" }
}

□曲リストクリア実行 {
	_script = □演奏ストップ
	//　ダウンロードした曲を全て削除（演奏中で消せなければ止まってから消す）
	foreach ○ダウンロード曲リスト ; _Filename {
	void □ファイル削除予約(_Filename)
	}
	○曲リスト = IARRAY
	○ダウンロード曲リスト = IARRAY
	○曲リスト更新=1
	ERASEVAR('○演奏中曲パス')
	void □曲名ウィンドウONなら表示
	_script + □削除待ち処理予約 + "\cクリアしました。\e"
}


