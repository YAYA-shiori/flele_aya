}

On_曲フォルダ選択 {
if reference2 == '' {
	return
	}
_dir = □ダイアログのパス(reference2)
//フォルダ内のファイル名をそのまま後ろにつなぐので、末尾を \ にする
if SUBSTR(_dir,STRLEN(_dir)-1,1) != '\' { _dir += '\' }
○ディレクトリ = _dir
□ディレクトリドロップ処理
}

//ダイアログの結果のパスは区切りが / で届くので、曲リストと同じ \ に戻す
