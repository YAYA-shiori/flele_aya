//******************************************************************************
// FLELE
// キーコンフィグ（ショートカットキーの変更メニュー）
//
// ○キー設定は26個の配列。
//   [0]〜[7]   : 現在有効な設定（曲再生 / 一時停止 / メニュー / 曲名ウィンドウ / 曲クリア / 終了 / 次の曲 / 前の曲）
//   [20]〜[27] : メニューで編集中の設定。［これで決定］で [0]〜[7] に反映する
//******************************************************************************

//------------------------------------------------------------------------------
// キーコンフィグを開く。現在の設定を編集用の領域（[20]〜[27]）にコピーしてから表示する
//------------------------------------------------------------------------------
□キー設定_pre
{
	for _i = 0 ; _i < 8 ; _i++ {
		○キー設定[20 + _i] = ○キー設定[_i]
	}
	□キー設定
}

//------------------------------------------------------------------------------
// キーコンフィグの画面の見出し
//------------------------------------------------------------------------------
□キーコンフィグヘッダ
{
	": \_b[img\icon_keycon.png,inline] キーコンフィグ :::::::::::::::\n\n[half]"
}

//------------------------------------------------------------------------------
// キーコンフィグのトップ画面。各操作に割り当てたキーを一覧する
//------------------------------------------------------------------------------
□キー設定
{
	□メニューヘッダ
	--
	□キーコンフィグヘッダ
	--
	"ショートカットキーの［変更］から設定を変更し、決まったら［これで決定］をクリックしてください。\n/
		\n/
		\_b[img\icon_point.png,inline] 曲再生　　　　［%(キー設定表示名(20))］［\q[変更,□曲再生キー変更]］\n\n[half]/
		\_b[img\icon_point.png,inline] 一時停止　　　［%(キー設定表示名(21))］［\q[変更,□一時停止キー変更]］\n\n[half]/
			\_b[img\icon_point.png,inline] 次の曲　　　　［%(キー設定表示名(26))］［\q[変更,□次の曲キー変更]］\n\n[half]/
			\_b[img\icon_point.png,inline] 前の曲　　　　［%(キー設定表示名(27))］［\q[変更,□前の曲キー変更]］\n\n[half]/
		\_b[img\icon_point.png,inline] メニュー　　　［%(キー設定表示名(22))］［\q[変更,□メニューキー変更]］\n\n[half]/
		\_b[img\icon_point.png,inline] 曲名ウィンドウ［%(キー設定表示名(23))］［\q[変更,□曲ウィンドウキー変更]］\n\n[half]/
		\_b[img\icon_point.png,inline] 曲クリア　　　［%(キー設定表示名(24))］［\q[変更,□曲クリアキー変更]］\n\n[half]/
		\_b[img\icon_point.png,inline] 終了　　　　　［%(キー設定表示名(25))］［\q[変更,□終了キー変更]］\n\n[half]/
		\n　　　　　　［\q[これで決定,□キー設定完了]］/
		"
	--
	"\n\n\n[half]　　　　　　 \q[CLOSE,□close]｜\q[BACK,□メニュー_index]\e"
}

//------------------------------------------------------------------------------
// ○キー設定の_argv[0]番目のキーを、画面に表示する名前にして返す
//------------------------------------------------------------------------------
キー設定表示名
{
	_キー名 = ○キー設定[TOINT(_argv[0])]

	case _キー名 {
		when 'up' {
			'↑'
		}
		when 'left' {
			'←'
		}
		when 'down' {
			'↓'
		}
		when 'right' {
			'→'
		}
		when ':' {
			'*'
		}
		when ';' {
			'+'
		}
		when 'return' {
			'enter'
		}
		//「/」の時
		when '/' {
			'?'
		}
		//「\」の時
		when '￥' {
			'\\'
		}
		others {
			// 1文字のキーとファンクションキーは大文字で表示する
			if STRLEN(_キー名) <= 1 || SUBSTR(_キー名,0,1) == 'f' {
				TOUPPER(_キー名)
			}
			else {
				_キー名
			}
		}
	}
}

//------------------------------------------------------------------------------
// ［変更］を押された操作のキーを選ばせる。○イベント名の数字が、変更する設定の番号（0〜7）
//------------------------------------------------------------------------------
□曲再生キー変更
{
	○イベント名 = "キー変更0"
	□キー設定2
}

□一時停止キー変更
{
	○イベント名 = "キー変更1"
	□キー設定2
}

□メニューキー変更
{
	○イベント名 = "キー変更2"
	□キー設定2
}

□曲ウィンドウキー変更
{
	○イベント名 = "キー変更3"
	□キー設定2
}

□曲クリアキー変更
{
	○イベント名 = "キー変更4"
	□キー設定2
}

□終了キー変更
{
	○イベント名 = "キー変更5"
	□キー設定2
}

□次の曲キー変更
{
	○イベント名 = "キー変更6"
	□キー設定2
}

□前の曲キー変更
{
	○イベント名 = "キー変更7"
	□キー設定2
}

//------------------------------------------------------------------------------
// キーの選択画面。選ぶと □key_キー名 の選択肢として OnChoiceSelect から □キー選択 が呼ばれる。
//
// ホットキー（hotkey.dll）に使えないキーは載せていない:
// ^ ￥ @ + * ? F1〜F12 home end shift
//------------------------------------------------------------------------------
□キー設定2
{
	□メニューヘッダ
	--
	□キーコンフィグヘッダ
	--
	"\_b[img\icon_point.png,inline] 設定したいキーを選択してください。\n/
		\n/
		\q[ A ,□key_a]\q[ B ,□key_b]\q[ C ,□key_c]\q[ D ,□key_d]\q[ E ,□key_e]\q[ F ,□key_f]\q[ G ,□key_g]\q[ H ,□key_h]\q[ I ,□key_i]\q[ J ,□key_j]\q[ K ,□key_k]\q[ L ,□key_l]\n/
		\q[ M ,□key_m]\q[ N ,□key_n]\q[ O ,□key_o]\q[ P ,□key_p]\q[ Q ,□key_q]\q[ R ,□key_r]\q[ S ,□key_s]\q[ T ,□key_t]\q[ U ,□key_u]\q[ V ,□key_v]\q[ W ,□key_w]\q[ X ,□key_x]\n/
		\q[ Y ,□key_y]\q[ Z ,□key_z]\n/
		\n \q[enter,□key_return]　\q[space,□key_space]　\q[backspace,□key_back]　\q[tab,□key_tab]/
		\n \q[insert,□key_insert]　\q[delete,□key_delete]/
		\n/
		\n \q[↑,□key_up] \q[←,□key_left] \q[↓,□key_down] \q[→,□key_right]/
		\n\n\n　　　　　　 \q[CLOSE,□close]｜\q[BACK,□キー設定]\e"
}

//------------------------------------------------------------------------------
// 選ばれたキー（reference[0] は □key_ + キー名）を、編集中の設定に反映する。
// 他の操作に割り当て済みのキーなら、断ってやり直させる
//------------------------------------------------------------------------------
□キー選択
{
	_選択key = REPLACE(reference[0],"□key_","")
	_設定箇所 = TOINT(REPLACE(○イベント名,"キー変更",""))
	_i = _設定箇所 + 20

	// 変更中の操作自身のキーは重複とみなさないよう '_' に置き換えて探す
	_仮キー配列 = (○キー設定[20],○キー設定[21],○キー設定[22],○キー設定[23],○キー設定[24],○キー設定[25],○キー設定[26],○キー設定[27])
	_仮キー配列[_設定箇所] = '_'
	if ASEARCH(_選択key,_仮キー配列) != -1 {
		□メニューヘッダ
		--
		□キーコンフィグヘッダ
		--
		"\0\_b[img\icon_point.png,inline] そのキーは既に他のショートカットに設定されています。\_q\x"
		--
		□キー設定
	}
	else {
		○キー設定[_i] = _選択key
		--
		□キー設定
	}
}

//------------------------------------------------------------------------------
// ［これで決定］。編集中の設定を有効にして、ホットキーを登録し直す
//------------------------------------------------------------------------------
□キー設定完了
{
	for _i = 0 ; _i < 8 ; _i++ {
		○キー設定[_i] = ○キー設定[20 + _i]
	}
	if ○ホットキー操作 == "ON" {
		void SAORI("saori\hotkey.dll")
		□ホットキー準備
	}
	□メニューヘッダ
	--
	□キーコンフィグヘッダ
	--
	"\v\_b[img\icon_point.png,inline] キー設定完了しました。\_q\x"
	--
	□メニュー_index
}
