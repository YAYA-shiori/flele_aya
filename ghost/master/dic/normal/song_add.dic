//******************************************************************************
// FLELE
// 曲の追加（ファイル・フォルダの選択と入力、ドロップ、URLからのダウンロード）と、インプットボックスの結果
//******************************************************************************

//------------------------------------------------------------------------------
// 「曲/m3u手動追加」の画面。ファイルやフォルダを、ダイアログで選ぶか、パスを入力して追加する
//------------------------------------------------------------------------------
□手動で曲を追加
{
	□メニューヘッダ
	--
	": \_b[img\icon_fopen.png,inline] 曲/m3u手動追加 ::::::::::::::::\n\n"
	--
	"\_b[img\icon_point.png,inline] %(fcl)%(fcc)\q[参照して追加,□曲を参照して追加]\n　/
		└\q[フォルダの曲を全て追加,□フォルダを参照して追加]\f[color,default]\f[cursorfontcolor,default]\n\n[half]/
		\_b[img\icon_point.png,inline] %(fcl)%(fcc)\q[パスを入力して追加,□曲をパス入力で追加]\n　/
		└\q[フォルダのパスを入力して追加,□フォルダをパス入力で追加]\f[color,default]\f[cursorfontcolor,default]\n\n[half]/
		"
	--
	"\n\n　　　　　　 \q[CLOSE,□close]｜\q[BACK,□メニュー_index]\e"
}

//------------------------------------------------------------------------------
// ファイルの選択ダイアログを開く。
// ファイル・フォルダの選択はSSP本体のダイアログで行う。
// 選ぶと --id= の名前のイベントが、キャンセルすると OnSystemDialogCancel が届く
// （メニューは \C で出したままにする）
//------------------------------------------------------------------------------
□曲を参照して追加
{
	"\C\![open,dialog,open,--title=曲/m3uを選択,--filter=音楽ファイル/m3u|*.mid;*.mp3;*.wav;*.wma;*.ogg;*.m4a;*.aac;*.flac;*.opus;*.m3u;*.pls|すべてのファイル|*.*,--id=On_曲ファイル選択]"
}

//------------------------------------------------------------------------------
// 選択ダイアログで選ばれたファイル（reference[2]）を曲リストに追加する
//------------------------------------------------------------------------------
On_曲ファイル選択
{
	if reference[2] == '' {
		return
	}
	○path = □ダイアログのパス(reference[2])
	□ファイルがドロップされた
}

//------------------------------------------------------------------------------
// フォルダの選択ダイアログを開く。結果は On_曲フォルダ選択 に届く
//------------------------------------------------------------------------------
□フォルダを参照して追加
{
	"\C\![open,dialog,folder,--title=曲を追加するフォルダを選択,--id=On_曲フォルダ選択]"
}

//------------------------------------------------------------------------------
// 選択ダイアログで選ばれたフォルダ（reference[2]）の曲を全て曲リストに追加する
//------------------------------------------------------------------------------
On_曲フォルダ選択
{
	if reference[2] == '' {
		return
	}
	_dir = □ダイアログのパス(reference[2])
	//フォルダ内のファイル名をそのまま後ろにつなぐので、末尾を \ にする
	if SUBSTR(_dir,STRLEN(_dir)-1,1) != '\' {
		_dir += '\'
	}
	○ディレクトリ = _dir
	□ディレクトリドロップ処理
}

//------------------------------------------------------------------------------
// ファイルのパスを入力するインプットボックスを開く。結果は OnUserInput （ID: mpath）に届く
//------------------------------------------------------------------------------
□曲をパス入力で追加
{
	"\0\![open,inputbox,mpath,-1]\e"
	□ヘルプメニュー消滅した
}

//------------------------------------------------------------------------------
// フォルダのパスを入力するインプットボックスを開く。結果は OnUserInput （ID: mfpath）に届く
//------------------------------------------------------------------------------
□フォルダをパス入力で追加
{
	"\0\![open,inputbox,mfpath,-1]\e"
	□ヘルプメニュー消滅した
}

//------------------------------------------------------------------------------
// ダイアログの結果のパスは区切りが / で届くので、曲リストと同じ \ に戻す
//------------------------------------------------------------------------------
□ダイアログのパス
{
	REPLACE(_argv[0],'/','\')
}

//------------------------------------------------------------------------------
// ダイアログがキャンセルされた（reference[1] は --id= の名前）。元の画面にもどす
//------------------------------------------------------------------------------
OnSystemDialogCancel
{
	case reference[1] {
		when 'On_曲ファイル選択','On_曲フォルダ選択' {
			□手動で曲を追加
		}
		when 'On_m3u出力先選択' {
			□曲リスト出力
		}
	}
}

//------------------------------------------------------------------------------
// インプットボックスの入力結果。reference[0] が ID、reference[1] が入力された文字列
//   url   : 曲のURL。ダウンロードする
//   mpath : 曲ファイルのパス。曲リストに追加する
//   mfpath: フォルダのパス。中の曲を曲リストに追加する
//------------------------------------------------------------------------------
OnUserInput
{
	"\0"
	--
	//　空打ち確認
	if reference[1] == "" {
		"\b[-1]"
	}
	else {
		//　InputBoxID確認
		if reference[0] == "url" {
			//　URLだったらダウンロード
			if "http://" _in_ reference[1] {
				○URL = reference[1]
				□URLから曲ダウンロード
			}
			elseif !reference[1] {
				"\0\b[-1]\e"
			}
			//　URLじゃなかったら警告
			else {
				"サウンドファイルのURLを入力してください。\n[half]/
					\n　 \q[CLOSE,□close]｜\q[RETRY,□URL入力ダウンロード]/
					\e"
			}
		}
		elseif reference[0] == "mpath" {
			○path = 0
			○path = reference[1]
			if ○path != 0 {
				□ファイルがドロップされた
			}
		}
		elseif reference[0] == "mfpath" {
			○ディレクトリ = 0
			○path = reference[1]
			if FATTRIB(○path)[2] == 1 {
				○ディレクトリ = ○path
				□ディレクトリドロップ処理
			}
		}
	}
}

//******************************************************************************
// ファイル・フォルダ・プレイリストのドロップによる曲の追加
//
// 追加する曲のパスは、いったん○AllFilepath（配列）に入れてから□ドロップファイル処理で曲リストへ移す
//******************************************************************************

//------------------------------------------------------------------------------
// ファイルがドロップされた（複数のときは CHR(1) 区切りで reference[0] に入る）
//------------------------------------------------------------------------------
OnFileDrop2
{
	○path = 0
	○path = reference[0]
	□ファイルがドロップされた
}

//------------------------------------------------------------------------------
// ○path に入っているドロップされたものを、フォルダ・プレイリスト・曲ファイルに分けて処理する
//------------------------------------------------------------------------------
□ファイルがドロップされた
{
	"\0"
	--
	//　ディレクトリかどうか判断
	if FATTRIB(○path)[2] == 1 {
		○ディレクトリ = 0
		○ディレクトリ = reference[0]
		□ディレクトリパス調整
	}

	//　ディレクトリじゃなかったらファイルとして処理
	else {
		○ディレクトリ = 0
		//　簡易配列を汎用配列へ変換
		○AllFilepath = SPLIT(○path, CHR(1))
		○path = ○AllFilepath[0]
		_拡張子 = TOLOWER(SPLITPATH(○path)[3])
		// m3uを投げられた
		if _拡張子 == ".m3u" || _拡張子 == ".pls" {
			□プレイリスト処理
		}
		else {
			□ドロップファイル処理
		}
	}
	--
	"\e"
}

//------------------------------------------------------------------------------
// フォルダがドロップされた
//------------------------------------------------------------------------------
OnDirectoryDrop
{
	○ディレクトリ = 0
	○ディレクトリ = reference[0]
	□ディレクトリドロップ処理
}

//------------------------------------------------------------------------------
// ドロップされたフォルダ（○path）を○ディレクトリにして、中の曲を追加する
//------------------------------------------------------------------------------
□ディレクトリパス調整
{
	○ディレクトリ = ○path
	□ディレクトリドロップ処理
}

//------------------------------------------------------------------------------
// ○ディレクトリ（末尾は \）の中のファイルを全て、曲リストに追加する
//------------------------------------------------------------------------------
□ディレクトリドロップ処理
{
	"\0\b[6]\b[-1]"
	--
	//　ディレクトリに入ってるファイルを全て配列保存（カンマを含むファイル名が割れないよう、区切りを \x01 にする）
	○AllFilepath = SPLIT(FENUM(○ディレクトリ, CHR(1)), CHR(1))
	--
	□ドロップファイル処理
	--
	"\e"
}

//------------------------------------------------------------------------------
// ○AllFilepath のうち、音楽ファイルで、まだ曲リストに入っていないものを曲リストに追加し、
// 追加した曲数を報告する。○ディレクトリが 0 でなければ、各ファイル名の前に付けてパスにする
//------------------------------------------------------------------------------
□ドロップファイル処理
{
	_追加した曲数 = 0
	_既に入ってた曲数 = 0
	//ドロップされたファイル配列の各要素値を順番に取り出し
	foreach ○AllFilepath ; _Filename {
		//音楽ファイルかどうか拡張子で判断
		_拡張子 = TOLOWER(SPLITPATH(_Filename)[3])
		if □音楽ファイルの拡張子か(_拡張子) {
			//ディレクトリパスが付いてなかったら付ける
			if ○ディレクトリ != 0 {
				_Filename = ○ディレクトリ + _Filename
			}

			//音楽ファイルならリストに入っているか判断(無い場合-1)
			if ASEARCH(_Filename,○曲リスト) == -1 {
				//入っていない曲ならリストに追加
				if ○曲の数 <= 0 {
					○曲リスト = _Filename
				}
				else {
					○曲リスト = (○曲リスト,_Filename)
				}
				_追加した曲数++
			}
			//既に入ってた曲なら何もしないでカウント
			else {
				_既に入ってた曲数++
			}
		}
	}
	//曲追加した場合曲数報告
	--
	if _追加した曲数 >= 1 {
		○曲リスト更新 = 1
		□ヘルプメニュー消滅した
		--
		if ○曲の数 == 1 {
			○曲リスト = ○曲リスト[0]
		}
		"\b[0]\c%(○サーフェス)\s[0]%(_追加した曲数)曲追加。\w5\n曲リストには全%(○曲の数)曲入ってます。"
		--
		if _追加した曲数 == 1 {
			"\n\n[half]　　 \q[PLAY,□ドロップ曲再生]｜\q[CLOSE,□close]"
		}
		--
		"\w9\w9\w9\w9%(○サーフェス)"
	}

	//曲追加できなかった
	else {
		□ヘルプメニュー消滅した
		--
		//既に入ってた曲を1つ以上ドロップされた
		if _既に入ってた曲数 > 0 {
			"\b[0]\s[0]その曲はもう既に入っています。\w9\w9\w9\w9%(○サーフェス)"
		}
		//音楽ファイルが1つも無かった
		else {
			"\b[0]\s[0]追加できる音楽ファイルがありませんでした。\w9\w9\w9\w9%(○サーフェス)"
		}
	}
	//　セーブ
	SAVEVAR
}

//------------------------------------------------------------------------------
// 追加した曲（曲リストの最後）をすぐに演奏する。追加の報告の［PLAY］から呼ばれる
//------------------------------------------------------------------------------
□ドロップ曲再生
{
	○指定曲番号 = ○曲の数
	□曲ランダム再生
}

//------------------------------------------------------------------------------
// プレイリスト（m3u / pls）○path を読み、中の曲のパスを○AllFilepathに集めて曲リストに追加する
//------------------------------------------------------------------------------
□プレイリスト処理
{
	void FOPEN(○path,"r")
	_txt = 0
	_i = 0
	○AllFilepath = IARRAY
	while _txt != -1 && _i < 5000 {
		_i++
		_txt = FREAD(○path)
		_d = _i - 2
		//先頭にFile*=がついてたら削除
		if STRSTR(_txt,"File%(_d)=",0) == 0 {
			_txt = REPLACE(_txt, "File%(_d)=", "")
		}
		//先頭に#EXTM3Uや#EXTINFや[playlist]がついてなかったら○AllFilepathに追加
		if STRSTR(_txt,"[playlist]",0) != 0 && STRSTR(_txt,"#EXTM3U:",0) != 0 && STRSTR(_txt,"#EXTINF:",0) != 0 && _txt != -1 {
			○AllFilepath = (○AllFilepath,_txt)
		}
	}
	FCLOSE(○path)
	if ARRAYSIZE(○AllFilepath) >= 1 {
		□ドロップファイル処理
	}
}

//******************************************************************************
// URLからの曲のダウンロード
//
// ダウンロードした曲は ..\..\sound_file に置き、○ダウンロード曲リストに記録する。
// ダウンロードするURLは○URLに入れておく
//******************************************************************************

//------------------------------------------------------------------------------
// 音楽ファイルのリンクがバルーンにドロップされた。ダウンロードを始める
//------------------------------------------------------------------------------
OnURLQuery
{
	if "audio" _in_ reference[2] {
		○URL = reference[0]
		□URLから曲ダウンロード
	}
}

//------------------------------------------------------------------------------
// URLを入力するインプットボックスを開く。結果は OnUserInput （ID: url）に届く
//------------------------------------------------------------------------------
□URL入力ダウンロード
{
	○ヘルプメニュー表示中 = 0
	"\0\![open,inputbox,url,-1]\e"
}

//------------------------------------------------------------------------------
// ダウンロードするURL（○URL）のファイル名（拡張子付き）
//------------------------------------------------------------------------------
□URLのファイル名
{
	SPLITPATH(○URL)[2] + SPLITPATH(○URL)[3]
}

//------------------------------------------------------------------------------
// ○URL が音楽ファイルなら、ダウンロードを始める。
// 同じ名前のファイルが既にあれば、上書きするかどうかを確認する
//------------------------------------------------------------------------------
□URLから曲ダウンロード
{
	//　URLが音楽ファイルかどうか確認
	_拡張子 = TOLOWER(SPLITPATH(○URL)[3])
	if □音楽ファイルの拡張子か(_拡張子) {
		○DL成功 = 0
		"\0"
		--
		○上書き曲DL = 0
		_file = □URLのファイル名
		if FATTRIB("..\..\sound_file\%(_file)") != -1 {
			"\b[0]既に同じ名前のファイルがダウンロードされています。\w5\n上書きしますか？\w4\n[half]/
				\n　　　 \q[OK,□上書き曲ダウンロード]｜\q[NG,□close]/
				\e"
		}
		else {
			□曲ダウンロード開始
		}
	}
}

//------------------------------------------------------------------------------
// 同じ名前のファイルを上書きしてダウンロードする
//------------------------------------------------------------------------------
□上書き曲ダウンロード
{
	○上書き曲DL = 1
	_ファイル名 = □URLのファイル名
	_script = ''
	//上書きする曲を演奏中なら止める（古いファイルは、再生が止まった後のダウンロード完了時に消す）
	if TOLOWER(○演奏中曲絶対パス) == TOLOWER("%(○現在パス)sound_file\%(_ファイル名)") {
		_script = □演奏ストップ
	}
	_script + □曲ダウンロード開始
}

//------------------------------------------------------------------------------
// ○URL のダウンロードを非同期で始める。完了すると OnExecuteHTTPComplete が呼ばれる
//------------------------------------------------------------------------------
□曲ダウンロード開始
{
	_file = □URLのファイル名
	"\0\s[6]%(fcl)”%(_file)”\f[color,default]\n now loading...\![execute,http-get,%(○URL),--timeout=40,--async=soundfile,--file=%(_file)]\e"
}

//------------------------------------------------------------------------------
// ダウンロードの完了。ファイルを sound_file に移して、曲リストに追加する
//------------------------------------------------------------------------------
OnExecuteHTTPComplete
{
	if reference[0] == "get" && reference[1] == "soundfile" {
		_ファイル名 = □URLのファイル名
		//上書きのときは古いファイルを消してから移動する
		if ○上書き曲DL == 1 {
			void FDEL("..\..\sound_file\%(_ファイル名)")
		}
		//DLファイル移動
		_i = FMOVE("var\%(_ファイル名)","..\..\sound_file\")
		--
		if _i != 1 {
			○上書き曲DL = 0
			"\0\s[6]%(_ファイル名)をsound_fileフォルダに移動できませんでした。\w9\w9\w9\w9%(○サーフェス)\e"
		}
		elseif ○上書き曲DL == 1 {
			"\0\s[0]%(_ファイル名)を上書きしました。/
				\n\n[half]　　 \q[PLAY,□上書き曲再生]｜\q[CLOSE,□close]/
				\e"
			○上書き曲DL = 0
		}
		else {
			_Filename = "..\..\..\sound_file\%(_ファイル名)"

			//　まだ入ってないならダウンロード曲リストに追加
			if ASEARCH(_Filename,○ダウンロード曲リスト) == -1 {
				if ARRAYSIZE(○ダウンロード曲リスト) == 0 {
					○ダウンロード曲リスト = _Filename
				}
				else {
					○ダウンロード曲リスト = (○ダウンロード曲リスト,_Filename)
				}
			}
			○DL成功 = 1
			//　ファイルパスをAllFilepathに保存し処理
			○AllFilepath = _Filename
			□ドロップファイル処理
		}
	}
}

//------------------------------------------------------------------------------
// ダウンロードの失敗
//------------------------------------------------------------------------------
OnExecuteHTTPFailure
{
	"\0\s[6]\n\n　> Download-error\w9\w9\w9\w9%(○サーフェス)\b[-1]\e"
}

//------------------------------------------------------------------------------
// 上書きしてダウンロードした曲（○URL）を演奏する
//------------------------------------------------------------------------------
□上書き曲再生
{
	_ファイル名 = □URLのファイル名
	_Filename = "..\..\..\sound_file\%(_ファイル名)"
	○指定曲番号 = ASEARCH(_Filename,○曲リスト) + 1
	□曲ランダム再生
}

//------------------------------------------------------------------------------
// ダウンロードした曲を置いてある sound_file フォルダを開く
//------------------------------------------------------------------------------
□DL曲のフォルダを開く
{
	"\0\![open,file,..\..\sound_file]\c"
	--
	□メニュー_index
}
