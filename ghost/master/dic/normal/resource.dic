//******************************************************************************
// FLELE
// SSPが問い合わせる文字列リソース（ボタンの表示・リンク・ネットワーク更新のURL）
//
// On_名前 の関数が、SSPのリソース「名前」の値を返す
//******************************************************************************

//------------------------------------------------------------------------------
// リソース useorigin1 に 0 を返す
//------------------------------------------------------------------------------
On_useorigin1
{
	"0"
}

//******************************************************************************
// バルーンのメニューのボタン
//******************************************************************************

// ポータルのボタン（出さない）
On_portalrootbutton.caption
{
	"　"
}

On_portalrootbutton.visible
{
	"0"
}

// リンクのボタン
On_recommendrootbutton.caption
{
	"リンク(&R)"
}

// \1 側のリンクのボタン（出さない）
On_kero.recommendbutton.caption
{
	"　"
}

On_kero.recommendbutton.visible
{
	"0"
}

// 最小化のボタン
On_hidebutton.caption
{
	"最小化(&I)"
}

// 説明書のボタン
On_readmebutton.caption
{
	"FLELE取扱説明書(&G)"
}

//------------------------------------------------------------------------------
// リンクのボタンに並べるサイト（名前 ASC(1) URL ASC(2)）
//------------------------------------------------------------------------------
On_sakura.recommendsites
{
	"/

	Home%(ASC(1))/
	https://github.com/YAYA-shiori/flele_aya%(ASC(2))/

	iPod shuffle%(ASC(1))/
	https://www.apple.com/jp/%(ASC(2))/

	SSP%(ASC(1))/
	https://ssp.shillest.net/%(ASC(2))/

	"
}

