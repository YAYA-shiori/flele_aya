//******************************************************************************
// FLELE
// 音楽の演奏（SSP本体の\![sound]タグとsound系プロパティ）
//
// 演奏はSSP本体の \![sound] タグで行い、状態はsound系プロパティで本体に問い合わせる。
// SSPには曲のフルパス（絶対パス変換したもの）を渡し、同じ文字列を要素名として照合する。
// SSPは複数のサウンドを同時に鳴らせるので、曲を替えるときは必ず \![sound,stop] で止めてから鳴らす。
// イベントでスクリプトを返すと表示中のバルーンが閉じるので、裏で曲が替わるだけのときは先頭に \C を付ける。
//******************************************************************************

//------------------------------------------------------------------------------
// ボタン・キー・メニューから曲を演奏する（○指定曲番号があればその曲、無ければ演奏法に従って選ぶ）。
// 演奏を始めるスクリプトを返す
//------------------------------------------------------------------------------
□曲ランダム再生
{
	○ヘルプメニュー表示中 = 0
	_指定 = 0
	if ISVAR("○指定曲番号") == 1 {
		_指定 = TOINT(○指定曲番号)
		ERASEVAR("○指定曲番号")
	}
	if ○曲の数 < 1 {
		return
	}
	○連続エラー数 = 0
	//曲を指定されたときは、その曲が無くても他の曲に替えない
	if _指定 >= 1 && _指定 <= ○曲の数 {
		□曲番号を再生(_指定, 0)
	}
	else {
		□曲番号を再生(□最初の曲番号, □スキップできる演奏法)
	}
}

//------------------------------------------------------------------------------
// 曲リストの_argv[0]番目（1始まり）の曲を演奏するスクリプトを返す。
// _argv[1]が1なら、ファイルが見つからない曲を飛ばして次の曲を探す。
// 演奏できる曲が見つからなければ、演奏を止めて理由を伝えるスクリプトを返す
//------------------------------------------------------------------------------
□曲番号を再生
{
	_n = ○曲の数
	_no = TOINT(_argv[0])
	_skip = TOINT(_argv[1])
	if _n < 1 {
		return
	}
	if _no < 1 || _no > _n {
		_no = 1
	}

	_開始前に止まっていた = (○演奏中 != 1)
	_試行 = 0
	_path = ''
	while 1 {
		_path = □曲リストの曲(_no - 1)
		if _path != '' && (FATTRIB(絶対パス変換(_path))) != -1 {
			break
		}
		_試行++
		if _skip != 1 || _試行 >= _n {
			_no = 0
		}
		else {
			_no = □スキップ先の曲番号(_no)
		}
		if _no < 1 {
			break
		}
	}

	//演奏できる曲が見つからなかった
	if _no < 1 {
		_script = □演奏ストップ
		void □曲名ウィンドウONなら表示
		if _試行 >= 2 {
			_script + "\b[0]曲リストの曲が見つかりませんでした。\n[half]\nファイルを移動・削除していないか確かめてください。\e"
		}
		else {
			_file = ((SPLITPATH (_path))[2]) + ((SPLITPATH (_path))[3])
			_script + "\b[0]%(fcl)”\_!%(_file)\_!”%(def)が見つかりません。\n[half]\nファイルを移動・削除していないか確かめてください。\e"
		}
		return
	}

	○演奏中曲No = _no
	○演奏中曲パス = _path
	○演奏中曲スキップ可 = _skip
	○再生時間帯[hour] = TOINT((○再生時間帯[hour])+1)
	○サーフェス = "\s[25]"
	○演奏中 = 1
	○一時停止中 = 0
	○エラー後次の曲待ち = 0
	○起動中演奏回++
	// ファイル名を曲名にする
	○演奏中曲名 = "%((SPLITPATH (○演奏中曲パス))[2])%((SPLITPATH (○演奏中曲パス))[3])"
	// タグに曲名があれば曲名にする（取れなければファイル名のまま）
	_m = □メディア情報(○演奏中曲絶対パス)
	if _m[0] != '' {
		○演奏中曲名 = REPLACE(REPLACE(REPLACE(_m[0],"[","［"),"]","］"),"\","￥")
	}
	//曲名ウィンドウ表示してたら曲名更新
	void □曲名ウィンドウONなら表示

	_script = "\![sound,stop]\![sound,play,%(□タグ引数(○演奏中曲絶対パス))]"
	//演奏していない状態だったら歌サーフェスにする
	if _開始前に止まっていた {
		_script += "\0\b[-1]\s[25]\e"
	}
	//演奏中に曲が替わるだけなら、表示中のバルーン（ヘルプメニューなど）を消さないよう \C で続ける
	else {
		_script = "\C" + _script
	}
	_script
}

//------------------------------------------------------------------------------
// 曲リストの_argv[0]番目（0始まり）の曲のパス
//------------------------------------------------------------------------------
□曲リストの曲
{
	_i = TOINT(_argv[0])
	if GETTYPE(○曲リスト) == 4 {
		○曲リスト[_i]
	}
	//1曲だけのときは配列でなく文字列になっていることがある
	elseif _i == 0 {
		○曲リスト
	}
	else {
		''
	}
}

//------------------------------------------------------------------------------
// 演奏中の曲が曲リストの何番目か（1始まり）
//------------------------------------------------------------------------------
□演奏中曲番号
{
	_i = ASEARCH(○演奏中曲パス,○曲リスト)
	if _i >= 0 {
		_i + 1
	}
	else {
		TOINT(○演奏中曲No)
	}
}

//------------------------------------------------------------------------------
// 演奏中の曲の絶対パス。SSPに渡す曲のパスはこれで、SSPからの通知の照合にも使う
//------------------------------------------------------------------------------
○演奏中曲絶対パス
{
	絶対パス変換(○演奏中曲パス)
}

//------------------------------------------------------------------------------
// 演奏中の曲名の文字数。メニューや曲名ウィンドウで長い曲名を省略するのに使う
//------------------------------------------------------------------------------
○曲名文字数
{
	STRLEN (○演奏中曲名)
}

//------------------------------------------------------------------------------
// 見つからない・再生できない曲を飛ばしてよい演奏法か（1: 飛ばしてよい）。
// 「一曲を一度だけ」「同じ曲をエンドレス」は、飛ばす先が無いので飛ばさない
//------------------------------------------------------------------------------
□スキップできる演奏法
{
	if (ASEARCH(○演奏法,'one','loop')) == -1 {
		1
	}
	else {
		0
	}
}

//------------------------------------------------------------------------------
// 最初に演奏する曲の番号（1始まり）。ランダムの演奏法では前回と違う曲を選ぶ
//------------------------------------------------------------------------------
□最初の曲番号
{
	_n = ○曲の数
	if _n <= 1 || ○演奏法 == "seq_one" {
		1
		return
	}
	//前回と違う曲をランダムに選ぶ
	_cur = ASEARCH(○演奏中曲パス,○曲リスト)
	_no = RAND(_n)
	if _no == _cur {
		_no = (_no + 1 + RAND(_n - 1)) % _n
	}
	_no + 1
}

//------------------------------------------------------------------------------
// 曲が最後まで演奏された後に演奏する曲の番号（0なら止める）。_argv[0]は今の曲の番号
//------------------------------------------------------------------------------
□次の曲番号
{
	_no = TOINT(_argv[0])
	_n = ○曲の数
	if _n < 1 {
		0
		return
	}
	case ○演奏法 {
		when "one" {
			0
		}
		when "loop" {
			_no
		}
		when "seq_one" {
			if _no >= _n {
				0
			}
			else {
				_no + 1
			}
		}
		when "seq_loop" {
			if _no >= _n {
				1
			}
			else {
				_no + 1
			}
		}
		others {
			□最初の曲番号
		}
	}
}

//------------------------------------------------------------------------------
// 見つからない・再生できない曲を飛ばすときの次の曲の番号（0なら止める）。
// ランダムでも全曲を一度ずつ試せるよう、リスト順に進める
//------------------------------------------------------------------------------
□スキップ先の曲番号
{
	_no = TOINT(_argv[0])
	_n = ○曲の数
	if _n < 1 {
		0
	}
	elseif _no < _n {
		_no + 1
	}
	elseif ○演奏法 == "seq_one" {
		0
	}
	else {
		1
	}
}

//------------------------------------------------------------------------------
// \![sound,play,～] などのタグに渡す引数（カンマを含むパスでも1つの引数になるよう""で囲む）
//------------------------------------------------------------------------------
□タグ引数
{
	_q = CHR(0x22)
	_q + REPLACE(_argv[0], _q, _q + _q) + _q
}

//------------------------------------------------------------------------------
// 演奏中の曲の状態をSSP本体に問い合わせる。
// 返値：'playing'（演奏中）、'pause'（一時停止中）、'none'（開かれていない）、''（問い合わせできない）
//------------------------------------------------------------------------------
□サウンド状態
{
	_name = TOLOWER(○演奏中曲絶対パス)
	if _name == '' {
		'none'
		return
	}
	_count = GET_PROPERTY('currentghost.sound.count')
	if SSTP.STATUS < 200 || SSTP.STATUS >= 300 {
		''
		return
	}
	_count = TOINT(_count)
	for _i = 0 ; _i < _count ; _i++ {
		if TOLOWER(GET_PROPERTY("currentghost.sound.index(%(_i)).name")) == _name {
			if TOINT(GET_PROPERTY("currentghost.sound.index(%(_i)).playing")) != 1 {
				'none'
			}
			elseif TOINT(GET_PROPERTY("currentghost.sound.index(%(_i)).pause")) == 1 {
				'pause'
			}
			else {
				'playing'
			}
			return
		}
	}
	'none'
}

//------------------------------------------------------------------------------
// 演奏中の曲の状態（本体に問い合わせできないときは、ゴースト側で覚えている状態）
//------------------------------------------------------------------------------
□演奏状態
{
	_s = □サウンド状態
	if _s == '' {
		if ○演奏中 == 1 {
			_s = 'playing'
		}
		elseif ○一時停止中 == 1 {
			_s = 'pause'
		}
		else {
			_s = 'none'
		}
	}
	_s
}

//------------------------------------------------------------------------------
// 一時停止ボタン・キーの操作。演奏中なら一時停止し、一時停止中なら再開する。
// 何も鳴っていなければ前回の曲を演奏する
//------------------------------------------------------------------------------
□演奏一時停止
{
	if ○曲の数 < 1 || (ISVAR('○演奏中曲パス')) == 0 {
		return
	}
	○ヘルプメニュー表示中 = 0
	_状態 = □演奏状態
	if _状態 == 'playing' {
		○演奏中 = 0
		○一時停止中 = 1
		○サーフェス = "\s[0]"
		void □曲名ウィンドウONなら表示
		"\![sound,pause]\0\b[-1]\s[0]\e"
	}
	elseif _状態 == 'pause' {
		○演奏中 = 1
		○一時停止中 = 0
		○サーフェス = "\s[25]"
		void □曲名ウィンドウONなら表示
		"\![sound,resume]\0\b[-1]\s[25]\e"
	}
	//何も鳴っていない（起動した直後や、最後まで演奏し終わった後）なら前回の曲を演奏
	else {
		○連続エラー数 = 0
		○演奏中 = 0
		○一時停止中 = 0
		□曲番号を再生(□演奏中曲番号, 0)
	}
}

//------------------------------------------------------------------------------
// 演奏を止めるスクリプトを返す。演奏中の曲を消したとき、曲リストを消したときなどに使う
//------------------------------------------------------------------------------
□演奏ストップ
{
	○演奏中 = 0
	○一時停止中 = 0
	○エラー後次の曲待ち = 0
	○サーフェス = "\s[0]"
	"\![sound,stop]\0\s[0]"
}

//------------------------------------------------------------------------------
// 曲が最後まで演奏された（\![sound,stop] で止めたときは通知されない）。
// 演奏法に従って次の曲を演奏する。reference[0]: 曲のパス  reference[1]: 終わり方（end は最後まで演奏した）
//------------------------------------------------------------------------------
OnSoundStop
{
	//自分が演奏している曲の通知だけを扱う
	if TOLOWER(reference[0]) != TOLOWER(○演奏中曲絶対パス) || (○演奏中 != 1 && ○一時停止中 != 1) {
		return
	}
	//再生ウィンドウが閉じられた
	if reference[1] != "end" {
		○演奏中 = 0
		○一時停止中 = 0
		○サーフェス = "\s[0]"
		void □曲名ウィンドウONなら表示
		"\0\s[0]\e"
		return
	}
	○連続エラー数 = 0
	_next = □次の曲番号(□演奏中曲番号)
	if _next < 1 {
		○演奏中 = 0
		○一時停止中 = 0
		○サーフェス = "\s[0]"
		void □曲名ウィンドウONなら表示
		"\0\c\s[0]\e"
	}
	else {
		□曲番号を再生(_next, □スキップできる演奏法)
	}
}

//------------------------------------------------------------------------------
// 曲を再生できなかった（対応していない形式、壊れたファイルなど）。
// reference[1]: エラーコード  reference[2]: 曲のパス  reference[3]: エラーメッセージ
//------------------------------------------------------------------------------
OnSoundError
{
	if TOLOWER(reference[2]) != TOLOWER(○演奏中曲絶対パス) || ○演奏中 != 1 {
		return
	}
	_理由 = REPLACE(REPLACE(reference[3], CHR(0xd), ''), CHR(0xa), ' ')
	if _理由 == '' {
		_理由 = "エラーコード %(reference[1])"
	}
	_file = ((SPLITPATH (○演奏中曲パス))[2]) + ((SPLITPATH (○演奏中曲パス))[3])

	○演奏中 = 0
	○一時停止中 = 0
	○サーフェス = "\s[0]"
	○連続エラー数 = ○連続エラー数 + 1
	void □曲名ウィンドウONなら表示

	_script = "\0\b[0]\s[0]%(fcl)”\_!%(_file)\_!”%(def)を再生できませんでした。\n[half]\n\_!%(_理由)\_!"
	//連続再生中なら少し待って次の曲へ（全曲失敗したら止める）
	if ○演奏中曲スキップ可 == 1 && ○連続エラー数 < ○曲の数 {
		○エラー後次の曲待ち = 1
		"\![timerraise,3000,1,On_エラー後次の曲へ]" + _script + "\w9\w9\w9\w9%(○サーフェス)\e"
	}
	else {
		○連続エラー数 = 0
		_script + "\e"
	}
}

//------------------------------------------------------------------------------
// 再生エラーの数秒後に呼ばれ、次の曲を演奏する（OnSoundError の \![timerraise]）
//------------------------------------------------------------------------------
On_エラー後次の曲へ
{
	//待っている間に別の曲を演奏したり止めたりしていたら何もしない
	if ○エラー後次の曲待ち != 1 || ○演奏中 == 1 {
		return
	}
	○エラー後次の曲待ち = 0
	_next = □スキップ先の曲番号(□演奏中曲番号)
	if _next >= 1 {
		□曲番号を再生(_next, 1)
	}
}
