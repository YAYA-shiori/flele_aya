//******************************************************************************
// FLELE
// 曲リストの管理（曲数・パス変換・タグ・クリア・ダウンロード曲の削除）と、m3u出力
//
// 演奏中のファイルは消せないことがあり、\![sound,stop] はスクリプトの実行時に非同期で処理される。
// 消せなかったファイルは○削除待ちファイルに入れ、On_削除待ちファイル処理で後から消す。
//******************************************************************************

//------------------------------------------------------------------------------
// 曲リストに入っている曲の数
//------------------------------------------------------------------------------
○曲の数
{
	TOINT((ARRAYSIZE(○曲リスト)))
}

//------------------------------------------------------------------------------
// 曲リストの曲のパスを絶対パスにする。
// sound_file フォルダの曲は ..\..\..\sound_file\ から始まる相対パスで入っているので、ゴーストのフォルダ（○現在パス）からのパスに直す
//------------------------------------------------------------------------------
絶対パス変換
{
	//相対パスなら絶対パスになおす
	if "..\..\..\sound_file\" _in_ _argv[0] {
		REPLACE(_argv[0],"..\..\..\sound_file\","%(○現在パス)sound_file\")
	}
	else {
		_argv[0]
	}
}

//------------------------------------------------------------------------------
// 曲リストに追加できる音楽ファイルの拡張子か（_argv[0] は . 付きの小文字の拡張子）
//------------------------------------------------------------------------------
□音楽ファイルの拡張子か
{
	(ASEARCH(_argv[0],'.mid','.mp3','.wav','.wma','.ogg','.m4a','.aac','.flac','.opus')) != -1
}

//------------------------------------------------------------------------------
// ○path の曲のファイルサイズを、GB / MB / KB は小数1桁まで、1000未満は byte で表した文字列（ファイルが無ければ全角スペース）
//------------------------------------------------------------------------------
○現在曲サイズ
{
	_i = FSIZE(絶対パス変換(○path))

	if _i == -1 {
		"　"
	}
	elseif _i>=1000000000 {
		_i/1000000000 + "." + _i%1000000000/100000000 + "GB"
	}
	elseif _i>=1000000 {
		_i/1000000 + "." + _i%1000000/100000 + "MB"
	}
	elseif _i>=1000 {
		_i/1000 + "." + _i%1000/100 + "KB"
	}
	else {
		"%(_i)byte"
	}
}

//------------------------------------------------------------------------------
// 曲ファイルのタグをSSP本体（SAORI over DirectSSTP の internal_file / MediaInfo）で読む。
// 再生していない曲でも、ファイルをロードせずに読める。_argv[0] は曲の絶対パス。
// 返値：(title, artist, album, genre, year, duration, comment) の配列。取れなかった値は空
//------------------------------------------------------------------------------
□メディア情報
{
	_v = ('','','','','','','')
	//使えない（旧SSP）ときは LIB.STATUSCODE が変わらないので、先に空にしておく
	LIB.STATUSCODE = ''
	void FUNCTIONEX('internal_file','MediaInfo',_argv[0],'title','artist','album','genre','year','duration','comment')
	//ファイルが無いなどの失敗（400/500）や使えないときは空のまま
	if STRSTR(LIB.STATUSCODE,'200',0) == 0 {
		for _i = 0 ; _i < 7 ; _i++ {
			//値の中の改行は 0x01 になって届く
			_v[_i] = REPLACE(TOSTR(valueex[_i]), CHR(1), ' ')
		}
	}
	_v
}

//------------------------------------------------------------------------------
// 曲リストのクリアを確認する。ダウンロードした曲があれば、それも削除することを伝える
//------------------------------------------------------------------------------
□曲リストクリア
{
	_ダウンロード曲数 = (ARRAYSIZE(○ダウンロード曲リスト))
	□ヘルプメニュー消滅した
	--
	// 曲が一曲以上あれば実行
	if ○曲の数 >= 1 {
		if _ダウンロード曲数 >= 1 {
			"\0\s[0]曲リスト全%(○曲の数)曲をクリア、\w3ダウンロード曲全%(_ダウンロード曲数)曲を削除します。\w5宜しいですか？"
		}
		else {
			"\0\s[0]曲リスト、\w2全%(○曲の数)曲をクリアします。\n\w4/
				宜しいですか？\w5\n[half]"
		}
		--
		"\n　　　 \q[OK,□曲リストクリア実行]｜\q[NG,□close]\e"
	}
	// 曲がなかった
	else {
		"\0\s[0]曲リストにはまだ何もありません。\e"
	}
}

//------------------------------------------------------------------------------
// ［OK］を押された。演奏を止めて、曲リストをクリアし、ダウンロードした曲のファイルを削除する
//------------------------------------------------------------------------------
□曲リストクリア実行
{
	_script = □演奏ストップ
	//　ダウンロードした曲を全て削除（演奏中で消せなければ止まってから消す）
	foreach ○ダウンロード曲リスト ; _Filename {
		void □ファイル削除予約(_Filename)
	}
	○曲リスト = IARRAY
	○ダウンロード曲リスト = IARRAY
	○曲リスト更新=1
	ERASEVAR('○演奏中曲パス')
	void □曲名ウィンドウONなら表示
	_script + □削除待ち処理予約 + "\cクリアしました。\e"
}

//------------------------------------------------------------------------------
// ファイルを消す。消せなければ削除待ちにする。返値：1 消した（または既に無い）、0 削除待ちにした
//------------------------------------------------------------------------------
□ファイル削除予約
{
	_f = 絶対パス変換(_argv[0])
	if (FATTRIB(_f)) == -1 {
		1
		return
	}
	if FDEL(_f) == 1 {
		1
		return
	}
	if (ASEARCH(_f,○削除待ちファイル)) == -1 {
		○削除待ちファイル = (○削除待ちファイル,_f)
	}
	0
}

//------------------------------------------------------------------------------
// 削除待ちのファイルを消す。返値：消せずに残ったファイルの数
//------------------------------------------------------------------------------
□削除待ちファイルを消す
{
	_残り = IARRAY
	foreach ○削除待ちファイル ; _f {
		if _f == '' || (FATTRIB(_f)) == -1 {
			continue
		}
		if FDEL(_f) != 1 {
			_残り = (_残り,_f)
		}
	}
	○削除待ちファイル = _残り
	ARRAYSIZE(○削除待ちファイル)
}

//------------------------------------------------------------------------------
// 削除待ちのファイルがあれば、少し後に消すスクリプトを返す
//------------------------------------------------------------------------------
□削除待ち処理予約
{
	if (ARRAYSIZE(○削除待ちファイル)) > 0 {
		○削除再試行回数 = 0
		"\![timerraise,500,1,On_削除待ちファイル処理]"
	}
}

//------------------------------------------------------------------------------
// 削除待ちのファイルを消す。消せなければ1秒おきに10回までやり直す（それでも消せなければ次の起動時に消す）
//------------------------------------------------------------------------------
On_削除待ちファイル処理
{
	_残り = □削除待ちファイルを消す
	//まだ消せなければ少し待ってやり直す（それでも消せなければ次の起動時に消す）
	if _残り > 0 && ○削除再試行回数 < 10 {
		○削除再試行回数 = ○削除再試行回数 + 1
		//表示中のバルーンを消さないよう \C で続ける
		"\C\![timerraise,1000,1,On_削除待ちファイル処理]"
	}
	else {
		○削除再試行回数 = 0
	}
}

//******************************************************************************
// 曲リストのm3u出力
//******************************************************************************

//------------------------------------------------------------------------------
// 「曲リスト出力」の画面。出力先のパスを確認・変更し、出力する
//------------------------------------------------------------------------------
□曲リスト出力
{
	□メニューヘッダ
	--
	": \_b[img\icon_m3u.png,inline] 曲リスト出力 :::::::::::::::::\n\n[half]"
	--
	"曲リストをm3u形式で出力します。\n/
		\n\_b[img\icon_point.png,inline] 出力先パス ［\q[変更,□出力先ディレクトリ変更]］［\q[開く,□m3uフォルダを開く]］/
		\n%(fcl)\_!%(○m3u出力パス)\_!\f[color,default]"
	--
	if ○曲の数 >= 1 {
		"\n\n　　　　　　 ［\q[出力する,□m3uで出力]］\n"
	}
	else {
		"\n\n　　　　　 - no data -\n"
	}
	--
	"\n\n[half]　　　　　　 \q[CLOSE,□close]｜\q[BACK,□メニュー_index]\e"
}

//------------------------------------------------------------------------------
// 出力先を選ぶ「名前を付けて保存」ダイアログをSSP本体で開く。結果は On_m3u出力先選択 に届く
//------------------------------------------------------------------------------
□出力先ディレクトリ変更
{
	_dir = SPLITPATH(○m3u出力パス)[0] + SPLITPATH(○m3u出力パス)[1]
	_name = SPLITPATH(○m3u出力パス)[2]
	"\C\![open,dialog,save,--title=曲リストの出力先,%(□タグ引数('--dir=' + _dir)),--filter=m3u|*.m3u,--ext=m3u,%(□タグ引数('--name=' + _name)),--id=On_m3u出力先選択]"
}

//------------------------------------------------------------------------------
// ダイアログで選ばれた出力先（reference[2]）を、○m3u出力パスにする。
// フォルダが無いか、拡張子が .m3u でなければ受け付けない
//------------------------------------------------------------------------------
On_m3u出力先選択
{
	if reference[2] == '' {
		return
	}
	_path = □ダイアログのパス(reference[2])
	_拡張子 = TOLOWER(SPLITPATH(_path)[3])

	if FATTRIB(SPLITPATH(_path)[0] + SPLITPATH(_path)[1])[2] != 1 {
		□曲リスト出力
	}
	elseif _拡張子 != ".m3u" {
		"m3uファイルを選択するか、.m3uの付いたファイル名を入力してください。\n[half]/
			\n　 \q[CLOSE,□close]｜\q[RETRY,□出力先ディレクトリ変更]/
			\e"
	}
	else {
		○m3u出力パス = _path
		□曲リスト出力
	}
}

//------------------------------------------------------------------------------
// 出力先のフォルダをエクスプローラーで開く
//------------------------------------------------------------------------------
□m3uフォルダを開く
{
	_dpath = SPLITPATH(○m3u出力パス)[0] + SPLITPATH(○m3u出力パス)[1]
	// 末尾の \ を落とす
	_i = STRLEN(_dpath) - 1
	_dpath = SUBSTR(_dpath,0,_i)

	"\0\![open,file,%(_dpath)]\c"
	--
	□曲リスト出力
}

//------------------------------------------------------------------------------
// ［出力する］。同じ名前のファイルがあれば、上書きするかどうかを確認する
//------------------------------------------------------------------------------
□m3uで出力
{
	○ヘルプメニュー表示中 = 0
	if FATTRIB(○m3u出力パス) != -1 {
		"既に同じファイル名のファイルが存在します。\w5\n上書きしますか？\w4\n[half]/
			\n　　　 \q[OK,□m3u上書き出力]｜\q[NG,□曲リスト出力]/
			\e"
	}
	else {
		□m3u上書き出力
	}
}

//------------------------------------------------------------------------------
// m3uを出力して、結果（成功か失敗か）を報告する
//------------------------------------------------------------------------------
□m3u上書き出力
{
	□m3u生成
	--
	if ○成否 == 1 {
		_file = SPLITPATH(○m3u出力パス)[2] + SPLITPATH(○m3u出力パス)[3]

		"\0%(○サーフェス)\s[0]曲リスト%(fcl)”%(_file)”\f[color,default]を出力しました。/
			\n\n　　\q[OPEN FOLDER,□m3uフォルダを開く]/
			\n　　　 \q[CLOSE,□close]/
			\w9\w9\w9\w9%(○サーフェス)/
			\e"
	}
	else {
		"\0曲リスト出力に失敗しました。\e"
	}
}

//------------------------------------------------------------------------------
// 曲リストのパスを dat\tmp.m3u に書き出してから、○m3u出力パス に移す。
// 成功したら○成否を 1 にする
//------------------------------------------------------------------------------
□m3u生成
{
	○成否 = 0
	// 出力先のフォルダ（末尾は \）。ここに一時ファイルを置いてから移す
	_di = SPLITPATH(○m3u出力パス)[0] + SPLITPATH(○m3u出力パス)[1]
	void FDEL(_di + "tmp.m3u")
	void FDEL(○m3u出力パス)
	void FCHARSET(0)
	if FOPEN("dat\tmp.m3u","w") != 0 {
		foreach ○曲リスト ; _i {
			_i = 絶対パス変換(_i)
			void FWRITE("dat\tmp.m3u",_i)
		}
		void FCLOSE("dat\tmp.m3u")
		if FCOPY("dat\tmp.m3u",_di) == 1 {
			○成否 = FRENAME(_di + "tmp.m3u",○m3u出力パス)
		}
	}
}
