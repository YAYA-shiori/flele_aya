//******************************************************************************
// FLELE
// シェル・バルーン・着せ替え・ウィンドウ状態・サーフェスの変化への対応と、シェル別の見た目（文字色・メニュー背景）
//******************************************************************************

//******************************************************************************
// 表示するスクリプトの置換
//******************************************************************************

//------------------------------------------------------------------------------
// スクリプトを表示する直前の加工。
// 文字列の中に " を直接書けないので、トークには ” と書いておき、ここで " に直す。
// ミクのシェルでメイコの着せ替え中は、\1 側にメイコのサーフェス（700番台）を出す
//------------------------------------------------------------------------------
OnTranslate
{
	_text = reference[0]
	_text = REPLACE(_text, "”", "%(CHR(0x22))")

	if ○現在シェル == 'Miku' && 'Meiko' _in_ ○着せ替えoption {
		_text = REPLACE(_text, '\s[10]', '')
		_text = REPLACE(_text, '\s[0]', '\s[0]\1\s[700]\0')
		_text = REPLACE(_text, '\s[6]', '\s[6]\1\s[706]\0')
		_text = REPLACE(_text, '\s[25]', '\s[25]\1\s[725]\0')
	}
	_text
}

//******************************************************************************
// シェル・バルーン・着せ替え
//******************************************************************************

//------------------------------------------------------------------------------
// SSPが起動時などに通知する、現在のシェル名とバルーン名を覚える
//------------------------------------------------------------------------------
OnNotifySelfInfo
{
	○現在シェル = reference[3]
	○現在バルーン = reference[5]
}

//------------------------------------------------------------------------------
// シェルの切り替え
//------------------------------------------------------------------------------
OnShellChanged
{
	○ヘルプメニュー表示中 = 0
	○現在シェル = reference[0]
	"\0%(○サーフェス)\1\s[10]"
	--
	□タスクトレイアイコン指定

	"\e"
}

//------------------------------------------------------------------------------
// バルーンの切り替え
//------------------------------------------------------------------------------
OnBalloonChange
{
	○現在バルーン = reference[0]
	□ヘルプメニュー消滅した
}

//------------------------------------------------------------------------------
// バルーンが時間切れ・クリックで閉じられたとき。ヘルプメニューも消えている
//------------------------------------------------------------------------------
OnBalloonTimeout
{
	□ヘルプメニュー消滅した
}

OnBalloonBreak
{
	□ヘルプメニュー消滅した
}

//------------------------------------------------------------------------------
// 着せ替えの切り替え。ミクのシェルでメイコの着せ替えかどうかを覚える
//------------------------------------------------------------------------------
OnDressupChanged
{
	if ○現在シェル == 'Miku' {
		if (reference[1] + reference[2]) == 'Meiko1' {
			○着せ替えoption = 'Meiko'
		}
		else {
			○着せ替えoption = '-'
		}
		"\0%(○サーフェス)\1\s[10]\e"
	}
}

//------------------------------------------------------------------------------
// 起動時に通知される着せ替えの状態。ミクのシェルでメイコの着せ替えかどうかを覚える
//------------------------------------------------------------------------------
OnNotifyDressupInfo
{
	if ○現在シェル == 'Miku' {
		if reference[0] == '0,option,Meiko,,1,' && 'Meiko' != ○着せ替えoption {
			○着せ替えoption = 'Meiko'
		}
	}
}

//******************************************************************************
// ウィンドウ・サーフェス
//******************************************************************************

//------------------------------------------------------------------------------
// 最小化。曲名ウィンドウも閉じる
//------------------------------------------------------------------------------
OnWindowStateMinimize
{
	if ○曲名ウィンドウON == 1 {
		void SAORI("saori\bln.dll", "win01", "", "0", "0", "kyokumei")
	}
	□ヘルプメニュー消滅した
}

//------------------------------------------------------------------------------
// 最小化からの復元。シェルと曲名ウィンドウをもどす
//------------------------------------------------------------------------------
OnWindowStateRestore
{
	□表示
	□曲名ウィンドウONなら表示
	--
	"\e"
}

//------------------------------------------------------------------------------
// 歌っている・止まっているサーフェス（○サーフェス）と違うサーフェスが
// 一定時間続いたらもどす
//------------------------------------------------------------------------------
OnSurfaceChange
{
	if reference[0] != ○サーフェス {
		"\0%(○サーフェス)\e"
	}
}

//------------------------------------------------------------------------------
// 現在のサーフェスでシェルを表示し直す
//------------------------------------------------------------------------------
□表示
{
	"\0%(○サーフェス)\1\s[10]"
	--
	□ヘルプメニュー消滅した
}

//------------------------------------------------------------------------------
// タスクトレイのアイコンをシェルの色に合わせる
//------------------------------------------------------------------------------
□タスクトレイアイコン指定
{
	case ○現在シェル {
		when "Black" ; "\![set,tasktrayicon,img\fle_b.ico]"
		when "White" ; "\![set,tasktrayicon,img\fle_w.ico]"
		when "MA564J/A" ; "\![set,tasktrayicon,img\fle_m.ico]"
		others ; "\![set,tasktrayicon,img\fle_n.ico]"
	}
}

//******************************************************************************
// シェル・バルーンごとの見た目（文字色・メニュー背景）
//
// メニューやトークの中から %(fcl) のように埋め込んで使う
// メニュー用の小さなアイコンは \_b[img\icon_名前.png,inline]、
// 文字色を標準にもどすのは \f[color,default] と \f[cursorfontcolor,default] を直接書く
//******************************************************************************

//------------------------------------------------------------------------------
// fcl: 強調する文字の色にする。シェルに合わせた色になる。
// 色を変えられるのは、FLELE用バルーンのとき。元に戻すのは \f[color,default]
//------------------------------------------------------------------------------
fcl
{
	if 'for flele' _in_ ○現在バルーン {
		'\f[color,'
		--
		色番号指定
		--
		']'
	}
}

//------------------------------------------------------------------------------
// fcc: 選択肢にカーソルを合わせたときの文字色を、fcl と同じ色にする。
// 元に戻すのは \f[cursorfontcolor,default]
//------------------------------------------------------------------------------
fcc
{
	if 'for flele' _in_ ○現在バルーン {
		'\f[cursorfontcolor,'
		--
		色番号指定
		--
		']'
	}
}

//------------------------------------------------------------------------------
// 現在のシェルの強調文字色（R,G,B）。fcl / fcc が使う
//------------------------------------------------------------------------------
色番号指定
{
	case ○現在シェル {
		// 灰
		when 'Silver','Button','White','Milk','flelec','MA564J/A' ; '150,150,150'
		// 黒
		when 'Black','Klotz','Sorcerer-F' ; '10,10,10'
		// 緑系
		when 'Lime' ; '107,188,51'
		when 'Mint','Gretel' ; '105,164,139'
		// 深緑
		when 'Saxophone' ; '61,117,89'
		// 赤系
		when 'Christmas carol','Fifty-four','Apple','Ayame' ; '209,94,81'
		// ピンク系
		when 'Peach' ; '205,112,113'
		when 'Pink' ; '220,74,132'
		// 紫系
		when 'Lavender','Classic' ; '142,119,155'
		// 青系
		when 'Blue' ; '68,153,191'
		// 水色系
		when 'Sky','Hebel','Summer plateau' ; '96,153,183'
		when 'Conductor' ; '48,142,153'
		when 'Miku','Miku - small','Miku - sitting','はちゅねさん' ; '12,186,198'
		// 黄色系
		when 'Lemon' ; '228,110,36'
		when 'Orange' ; '228,110,36'
		// 他
		others ; '49,150,153'
	}
}

//------------------------------------------------------------------------------
// mffc: 曲リストメニュー（Weirds.dll）で選択中の項目の文字色（foreground.font.color）
//------------------------------------------------------------------------------
mffc
{
	case ○現在シェル {
		// 背景色が濃い場合文字を白に
		when 'Black','Christmas carol','Apple','Ayame','Sorcerer-F','Fifty-four','Klotz' ; '255,255,255'
		// 他は黒
		others ; '10,10,10'
	}
}

//------------------------------------------------------------------------------
// mfbc: 曲リストメニュー（Weirds.dll）で選択中の項目の背景色（foreground.base.color）
//------------------------------------------------------------------------------
mfbc
{
	case ○現在シェル {
		// 緑系
		when 'Lime' ; '180,254,84'
		// 黒
		when 'Black','Sorcerer-F','Klotz' ; '30,30,30'
		// 紫系
		when 'Lavender','Classic' ; '227,213,236'
		// 黄系
		when 'Orange','Lemon' ; '252,169,100'
		// 青系
		when 'Blue' ; '153,209,242'
		when 'Sky','Hebel' ; '198,219,243'
		when 'Summer plateau' ; '209,224,255'
		when 'Conductor' ; '209,224,255'
		when 'Mint' ; '178,237,204'
		when 'Miku','Miku - small','Miku - sitting','はちゅねさん' ; '223,252,255'
		// 赤系
		when 'Christmas carol','Fifty-four','Ayame' ; '221,91,96'
		when 'Pink' ; '249,175,198'
		when 'Peach' ; '254,191,180'
		// 黄系
		when 'Saxophone' ; '255,238,141'
		// 茶系
		when 'Gretel' ; '206,188,163'
		// 他は灰色
		others ; '230,230,230'
	}
}

//------------------------------------------------------------------------------
// ヘルプメニューの背景画像（\_b）。FLELE用バルーンのときだけ指定する。
// 下の一覧のシェルには blbg_help_zukai.png、それ以外には blbg_help_zukai2.png を使う
//------------------------------------------------------------------------------
menu_bg
{
	if 'for flele' _in_ ○現在バルーン {
		'\_b[img/'
		--
		if ASEARCH(○現在シェル,'Lime','Pink','Peach','Black','Lavender','Orange','Blue','Sky','Mint','Christmas carol','Milk','Silver','Summer plateau','Apple','Lemon') != -1 {
			'blbg_help_zukai.png'
		}
		else {
			'blbg_help_zukai2.png'
		}
		--
		','
		--
		if ○現在バルーン == 'for flele / wide' {
			'46,41'
		}
		else {
			'17,39'
		}
		--
		']'
	}
}
