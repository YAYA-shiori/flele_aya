//******************************************************************************
// FLELE
// ヘルプメニューの設定画面（動作設定・再生方法）
//******************************************************************************

//------------------------------------------------------------------------------
// 設定のトップ画面。再生の設定と動作設定へのリンクを並べる
//------------------------------------------------------------------------------
□設定
{
	□メニューヘッダ
	--
	": %(アイコン2('hotkey'))設定 :::::::::::::::::::::::::\n\n"
	--

	"%(アイコン2('point'))%(fcl)%(fcc)\q[音楽再生の設定,□再生設定]%(def)%(defc)\n\n[half]"
	--
	"%(アイコン2('point'))%(fcl)%(fcc)\q[動作設定,□動作設定]%(def)%(defc)\n\n"
	--

	"\n　　　　　　　\q[CLOSE,□close]｜\q[BACK,□メニュー_index]\e"
}

//------------------------------------------------------------------------------
// 動作設定の画面。ホットキー操作と曲リストメニューのON/OFFを切り替える
//------------------------------------------------------------------------------
□動作設定
{
	□メニューヘッダ
	--
	": %(アイコン2('hotkey'))動作設定 :::::::::::::::::::::\n\n"
	--

	"%(アイコン2('point'))インアクティブ時%(fcl)Ctrl + Shift + Key%(def)でキー操作\n\n[half]"
	--
	if ○ホットキー操作=="ON" {
		"　　　　%(fcl)ON%(def) ［\q[変更,□ホットキーOFF]］"
	}
	else {
		"　　　　%(fcl)OFF%(def)［\q[変更,□ホットキーON]］"
	}
	--
	"\n\n%(アイコン2('point'))曲リストメニュー(music list)を出す\n\n[half]"
	--
	if ○曲リストメニュー=="ON" {
		"　　　　%(fcl)ON%(def) ［\q[変更,□曲リストメニューOFF]］"
	}
	else {
		"　　　　%(fcl)OFF%(def)［\q[変更,□曲リストメニューON]］"
	}
	--

	"\n\n[half]/
		\n　　　　　　　\q[CLOSE,□close]｜\q[BACK,□設定]\e"
}

//------------------------------------------------------------------------------
// ホットキー操作をOFFにする。hotkey.dllの登録を解除し、SHIORIを再読み込みして反映する
//------------------------------------------------------------------------------
□ホットキーOFF
{
	○ホットキー操作 = "OFF"
	□ホットキー停止
	--
	"\![reload,shiori]"
	--
	□動作設定
}

//------------------------------------------------------------------------------
// ホットキー操作をONにする。hotkey.dllに登録し、SHIORIを再読み込みして反映する
//------------------------------------------------------------------------------
□ホットキーON
{
	○ホットキー操作 = "ON"
	□ホットキー準備
	--
	"\![reload,shiori]"
	--
	□動作設定
}

//------------------------------------------------------------------------------
// 曲リストメニュー（右クリックで出るメニュー）を使わない設定にする
//------------------------------------------------------------------------------
□曲リストメニューOFF
{
	○曲リストメニュー = "OFF"
	□動作設定
}

//------------------------------------------------------------------------------
// 曲リストメニュー（右クリックで出るメニュー）を使う設定にする
//------------------------------------------------------------------------------
□曲リストメニューON
{
	○曲リストメニュー = "ON"
	□動作設定
}

//------------------------------------------------------------------------------
// 再生方法の画面。［変更］を押すたびに 一度だけ → 同じ曲を繰り返し → ランダム → リスト順に繰り返し → リスト順に一周 の順で切り替える
//------------------------------------------------------------------------------
□再生設定
{
	□メニューヘッダ
	--
	": %(アイコン2('hotkey'))音楽再生の設定 :::::::::::::::\n\n[half]"
	--
	"%(アイコン2('point'))再生方法\n\n[half]"
	--
	case ○演奏法 {
		when "one" {
			"　　 %(fcl)一曲を一度だけ再生%(def)［\q[変更,□演奏法loop]］"
		}
		when "loop" {
			"　　 %(fcl)同じ曲をエンドレス再生%(def)［\q[変更,□演奏法random]］"
		}
		when "seq_loop" {
			"　　 %(fcl)リスト順にエンドレス再生%(def)［\q[変更,□演奏法seq_one]］"
		}
		when "seq_one" {
			"　　 %(fcl)リスト順に一周だけ再生%(def)［\q[変更,□演奏法one]］"
		}
		others {
			"　　 %(fcl)ランダムでエンドレス再生%(def)［\q[変更,□演奏法seq_loop]］"
		}
	}
	--
	"\n\n\n[half]　　　　　　　\q[CLOSE,□close]｜\q[BACK,□設定]\e"
}

//------------------------------------------------------------------------------
// 再生方法を「同じ曲をエンドレス」にする
//------------------------------------------------------------------------------
□演奏法loop
{
	○演奏法 = "loop"
	□再生設定
}

//------------------------------------------------------------------------------
// 再生方法を「ランダムでエンドレス」にする
//------------------------------------------------------------------------------
□演奏法random
{
	○演奏法 = "random"
	□再生設定
}

//------------------------------------------------------------------------------
// 再生方法を「一曲を一度だけ」にする
//------------------------------------------------------------------------------
□演奏法one
{
	○演奏法 = "one"
	□再生設定
}

//------------------------------------------------------------------------------
// 再生方法を「リスト順にエンドレス」にする
//------------------------------------------------------------------------------
□演奏法seq_loop
{
	○演奏法 = "seq_loop"
	□再生設定
}

//------------------------------------------------------------------------------
// 再生方法を「リスト順に一周だけ」にする
//------------------------------------------------------------------------------
□演奏法seq_one
{
	○演奏法 = "seq_one"
	□再生設定
}
