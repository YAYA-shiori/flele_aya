//******************************************************************************
// FLELE
// 表示言語の切り替えと、文言表の引き方
//
// 利用者に見える文字列は、辞書に直接書かず、言語ごとの文言表（lang_ja.dic / lang_en.dic）に置く。
// 辞書からは 文言('キー') で引く（複数形のある文言は 文言n）。
//
// 文言表は、□文言表_言語コード という関数が返すハッシュ（キー → 文字列）。
// 読み込んだ表は ○文言[言語コード][キー] に入る（ゴーストの起動のたびに作り直し、終了時に消す）。
// 文言表の中の文字列には、次の書き方ができる。
//   {0} {1} ...  文言() に渡した引数が入る（0 は2つ目の引数）
//   {fcl} {fcc}  シェルに合わせた強調色（fcl / fcc）が入る
//
// 翻訳する人へ: \q[表示,ID] の「表示」や、ダイアログの --title= / --filter= に入る文言には、, と ] を書かない
// （区切りとして解釈されて壊れる）。Weirds のメニューの項目は ASC(1) で区切るので、, を書いてもよい。
//
// 言語を足すには、lang_言語コード.dic に □文言表_言語コード を書くだけでよい。
// SSPの言語IDと言語コードの対応が □言語IDの言語コード に無い言語は、そこに1行足す。
// 表に無いキーは、現在の言語 → en → ja の順に探し、どこにも無ければキーの名前をそのまま出す。
//******************************************************************************

//------------------------------------------------------------------------------
// SSPから言語の通知を受ける。起動直後と、言語リソースを切り替えたときに届く。
// 起動直後のものは NOTIFY なのでスクリプトは返せない（返さなくてよい）。
//   reference[0]: 言語名  reference[1]: 言語ID（Windowsの言語ID。英語は 1033）
// 内蔵の日本語は、言語IDが 0 で、言語名が Japanese で届く（実機で確かめた）。
// 言語名は言語パックの作者が決めるので、言語IDが 0 のときだけ使う
//------------------------------------------------------------------------------
OnLanguageChange
{
	void □言語を設定(reference[1],reference[0])
}

//------------------------------------------------------------------------------
// ゴーストを読み込んだときに、文言表を作る（ネットワーク更新やSHIORIの再読み込みの後も作り直す）
//------------------------------------------------------------------------------
OnGhostLoad.言語
{
	void □文言表を読み込む
}

//------------------------------------------------------------------------------
// ゴーストを終了するときに、文言表を消す（表は起動のたびに作るので保存しない）
//------------------------------------------------------------------------------
OnGhostUnload.言語
{
	ERASEVAR('○文言')
}

//------------------------------------------------------------------------------
// 現在の表示言語の言語コード。まだ通知を受けていなければ ja
//------------------------------------------------------------------------------
□言語コード
{
	if ISVAR('○言語') == 1 && ○言語 != '' {
		○言語
	}
	else {
		'ja'
	}
}

//------------------------------------------------------------------------------
// 表示言語を、SSPの言語ID（_argv[0]）と言語名（_argv[1]）に合わせて切り替える。
// 言語IDは 1041 のような10進数でも、0x0411 のような16進数でもよい
//------------------------------------------------------------------------------
□言語を設定
{
	○言語 = □言語IDの言語コード(_argv[0],_argv[1])
	□文言表を読み込む
}

//------------------------------------------------------------------------------
// SSPの言語ID（_argv[0]）と言語名（_argv[1]）に対応する言語コードを返す。
// 言語IDが0でなければ、言語ID全体（1041 など）で探し、無ければ主言語（下位10ビット。
// 英語や日本語の方言をまとめる）で探す。それで決まらなければ、言語名（大文字小文字は問わない）で探す。
// 対応が無い言語や、文言表の無い言語は en にする（日本語以外はまず英語で応える）
//------------------------------------------------------------------------------
□言語IDの言語コード
{
	_id = _argv[0]
	if SUBSTR(_id,0,2) == '0x' {
		_id = HEXSTRTOI(ERASE(_id,0,2))
	}
	_id = TOINT(_id)

	//言語IDそのものに対応するもの（主言語だけでは分けられない言語）
	_全体 = IHASH(1028,'zhhant',3076,'zhhant',5124,'zhhant',2052,'zhhans',4100,'zhhans')
	//主言語に対応するもの
	_主言語 = IHASH(17,'ja',9,'en',18,'ko',25,'ru',4,'zhhans')
	//言語名に対応するもの（SSPに付属の言語パックの名前）
	_名前 = IHASH('japanese','ja','english','en','korean','ko','russian','ru','chinese-simplified','zhhans','chinese-traditional','zhhant')

	_code = ''
	if _id > 0 {
		if HASH_EXIST(_id,_全体) {
			_code = _全体[_id]
		}
		elseif HASH_EXIST(_id % 1024,_主言語) {
			_code = _主言語[_id % 1024]
		}
	}
	if _code == '' && HASH_EXIST(TOLOWER(_argv[1]),_名前) {
		_code = _名前[TOLOWER(_argv[1])]
	}
	if _code == '' || ISFUNC('□文言表_' + _code) == 0 {
		_code = 'en'
	}
	_code
}

//------------------------------------------------------------------------------
// 文言を探す言語の順番（現在の言語、en、ja。重複は除く）
//------------------------------------------------------------------------------
□言語の探索順
{
	_r = IARRAY
	foreach (□言語コード,'en','ja') ; _l {
		if ASEARCH(_l,_r) == -1 {
			_r = (_r,_l)
		}
	}
	_r
}

//------------------------------------------------------------------------------
// 探索順にある言語の文言表を読み込んで、○文言 を作り直す
//------------------------------------------------------------------------------
□文言表を読み込む
{
	○文言 = IHASH()
	_順 = □言語の探索順
	foreach _順 ; _l {
		if ISFUNC('□文言表_' + _l) == 1 {
			○文言[_l] = EVAL('□文言表_' + _l)
		}
	}
}

//------------------------------------------------------------------------------
// キー（_argv[0]）の文言がある言語のうち、探索順で最初のものの言語コード。どこにも無ければ空
//------------------------------------------------------------------------------
□文言のある言語
{
	if GETTYPE(○文言) != 5 {
		void □文言表を読み込む
	}
	_順 = □言語の探索順
	foreach _順 ; _l {
		if HASH_EXIST(_l,○文言) == 1 && HASH_EXIST(_argv[0],○文言[_l]) == 1 {
			_l
			return
		}
	}
	''
}

//------------------------------------------------------------------------------
// 現在の言語での文言を返す。
//   _argv[0]: キー  _argv[1]〜: 文言の {0} {1} ... に入れる値
// 差し込む値は、文言の中の {0} などを置き換えるだけで、中身は解釈しない（ファイル名に % や { があってもよい）
//------------------------------------------------------------------------------
文言
{
	_key = _argv[0]
	_l = □文言のある言語(_key)
	if _l == '' {
		_key
		return
	}
	_s = ○文言[_l][_key]
	if '{fcl}' _in_ _s {
		_s = REPLACE(_s,'{fcl}',fcl)
	}
	if '{fcc}' _in_ _s {
		_s = REPLACE(_s,'{fcc}',fcc)
	}
	//値の中に {1} などがあっても置き換わらないよう、先に目印にしてから値を入れる
	for _i = 1 ; _i < _argc ; _i++ {
		_s = REPLACE(_s,'{' + (_i - 1) + '}',CHR(1) + _i + CHR(2))
	}
	for _i = 1 ; _i < _argc ; _i++ {
		_s = REPLACE(_s,CHR(1) + _i + CHR(2),TOSTR(_argv[_i]))
	}
	_s
}

//------------------------------------------------------------------------------
// 個数によって言い方が変わる文言を返す。
//   _argv[0]: キー  _argv[1]: 個数  _argv[2]〜: 文言の {1} {2} ... に入れる値
// 文言の {0} には個数が入る。個数が1で「キー.1」の文言があれば、そちらを使う
// （英語の "1 song" と "2 songs" の書き分け用。日本語のように書き分けない言語は「キー.1」を書かない）
//------------------------------------------------------------------------------
文言n
{
	_key = _argv[0]
	_l = □文言のある言語(_key)
	if _l != '' && TOINT(_argv[1]) == 1 && HASH_EXIST(_key + '.1',○文言[_l]) == 1 {
		_key = _key + '.1'
	}
	文言(_key,_argv[1,100])
}
