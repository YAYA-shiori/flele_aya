//******************************************************************************
// FLELE
// 時刻合わせ・メール・ヘッドライン・RSS・インストール・ネットワーク更新などのイベント
//
// どれもSSPからの通知に対して、状況を短く伝えるだけのトーク。
// 処理の開始（〜Begin）は □EventBegin、通信の失敗（〜Failure）は □ConnectError か □InstallError を使う
//******************************************************************************

//******************************************************************************
// 時刻合わせ（SNTP）
//******************************************************************************

OnSNTPBegin
{
	□EventBegin
}

//------------------------------------------------------------------------------
// 時刻のずれの確認結果。\6 で時刻を合わせる
//------------------------------------------------------------------------------
OnSNTPCompare
{
	"\0\6\e"
}

//------------------------------------------------------------------------------
// 時刻を合わせた。reference[1] は 年,月,日,時,分,秒
//------------------------------------------------------------------------------
OnSNTPCorrect
{
	_t = SPLIT(reference[1],',')
	_時刻 = _t[0] + '/' + _t[1] + '/' + _t[2] + ' ' + _t[3] + ':' + _t[4] + ':' + _t[5]

	"\0\s[0]/
		\_q\n[half]/
		%(fcl)%(_時刻)\f[color,default]\n/
		\n[half]/
		\_q%(文言('net.sntp.done'))\w9\w9\w9\w9%(○サーフェス)\e"
}

OnSNTPFailure
{
	□ConnectError
}

//******************************************************************************
// メール（BIFF）
//******************************************************************************

OnBIFFBegin
{
	□EventBegin
}

//------------------------------------------------------------------------------
// メールが届いた。reference[2] を引用符で囲んで示し、続けて reference[3] / reference[0]、
// 最後に reference[1] をバイト数として示す
//------------------------------------------------------------------------------
OnBIFFComplete
{
	"\0mail> %(○サーフェス)”%(reference[2])”\w6\n/
		%(reference[3])/%(reference[0])\w6\n/
		%(reference[1])byte\e"
}

//------------------------------------------------------------------------------
// メールが届いた（BIFF2）。OnBIFFComplete と同じ並びで、reference[3] が無いもの
//------------------------------------------------------------------------------
OnBIFF2Complete
{
	"\0mail> %(○サーフェス)”%(reference[2])”\w6\n/
		%(reference[0])\w6\n/
		%(reference[1])byte\e"
}

OnBIFFFailure
{
	□ConnectError
}

//******************************************************************************
// ヘッドラインセンス
//******************************************************************************

OnHeadlinesenseBegin
{
	□EventBegin
}

//------------------------------------------------------------------------------
// ヘッドラインの1件。reference[0]: タイトル  reference[1]: リンク  reference[2]: 位置（First / Next など）
// reference[3]: 本文。続きがあれば［NEXT］で次の1件に進む
//------------------------------------------------------------------------------
OnHeadlinesense.OnFind
{
	"\0\c%(○サーフェス)"
	--
	if ○現在バルーン == "for flele" {
		"\b[4]"
	}
	else {
		"\b[2]"
	}
	--
	"\![set,autoscroll,disable]\*\_q"
	--
	//タイトル//
	"%(fcl)”%(reference[0])”\f[color,default]\n[half]\n"
	--
	//本文//
	_本文 = reference[3]

	"%(_本文)\n[half]"
	--
	//リンク//
	if reference[2] == "First" || reference[2] == "Next" {
		"　　　\q[OPEN BROWSER,%(reference[1])]｜\q[CLOSE,□close]｜\q[NEXT,]"
	}
	else {
		"　　　　\q[OPEN BROWSER,%(reference[1])]｜\q[CLOSE,□close]"
	}
	--
	"\e"
}

OnHeadlinesenseComplete
{
	"\0\b[6]\w9%(○サーフェス)\e"
}

OnHeadlinesenseFailure
{
	□ConnectError
}

//******************************************************************************
// RSS
//******************************************************************************

OnRSSBegin
{
	□EventBegin
}

//------------------------------------------------------------------------------
// RSSの取得。reference[0]: サイト名  reference[1]: サイトのURL
// reference[2] 以降: 記事1件ごとの 記事名 + CHR(1) + URL。
// 最新の記事を並べ、選ぶと OnChoiceSelect から □RSSURLジャンプ が呼ばれる
//------------------------------------------------------------------------------
OnRSSComplete
{
	"\0\c%(○サーフェス)"
	--
	if ○現在バルーン == "for flele" {
		"\b[8]"
	}
	else {
		"\b[2]"
	}
	--
	"\![set,autoscroll,disable]\*\_q"
	--
	//タイトル//
	// 並べる記事の数
	_表示件数 = 12
	if STRLEN(reference[0]) >= 13 {
		_表示件数 = 11
	}
	elseif ○現在バルーン == "for flele / wide" {
		_表示件数 = 11
	}

	"%(fcl)”\q[%(reference[0]),%(reference[1])]”\f[color,default]%(文言('net.rss.latest',_表示件数))\n[half]\n"
	--
	//本文//
	_i = 1
	_txt = ""
	while _i <= _表示件数 {
		_i++
		_タイトル = (EVAL("reference" + _i))[0]
		_タイトル = REPLACE(_タイトル, '[' , '［')
		_タイトル = REPLACE(_タイトル, ']' , '］')
		_タイトル = REPLACE(_タイトル, '\' , '\\')
		_URL = (EVAL("reference" + _i))[1]
		if _URL != "" {
			if STRLEN(_タイトル) > 16 {
				_タイトル = SUBSTR(_タイトル,0,16) + "…"
			}
			elseif _タイトル == "" {
				_タイトル = "--------"
			}
			_txt = _txt + "%(_i-1)・\q[%(_タイトル),%(ASC(4))RSSURL_%(_URL)]\n[half]\n"
		}
	}
	--
	_txt
	--
	"　　　　　　　　\q[CLOSE,□close]"
	--
	"\e"
}

//------------------------------------------------------------------------------
// RSSの記事の選択（reference[0] は ASC(4) + RSSURL_ + URL）。URLをブラウザで開く
//------------------------------------------------------------------------------
□RSSURLジャンプ
{
	_URL = REPLACE(reference[0],"%(ASC(4))RSSURL_","")
	○URL = _URL
	"\j[%(_URL)]"
}

OnRSSFailure
{
	□ConnectError
}

//******************************************************************************
// インストール
//******************************************************************************

OnInstallBegin
{
	□EventBegin
}

//------------------------------------------------------------------------------
// インストールの完了。reference[0]: 種類（shell / rss など）  reference[1]: 名前。
// シェルなら、そのシェルに切り替える
//------------------------------------------------------------------------------
OnInstallComplete
{
	"\0%(○サーフェス)install complete\n[half]\n"
	--
	case reference[0] {
		when "rss" ; "RSS"
		others ; reference[0]
	}
	--
	" %(fcl)”%(reference[1])”\f[color,default]"
	--
	if reference[0] == "shell" {
		"\w9\w9\w9\w9\w9\w9\![change,shell,%(reference[1])]"
	}
	--
	"\e"
}

//------------------------------------------------------------------------------
// インストールの失敗。曲のダウンロード（○DL成功）に伴うものは知らせない
//------------------------------------------------------------------------------
OnInstallFailure
{
	if ○DL成功 == 0 {
		□InstallError
	}
}

OnInstallRefuse
{
	□InstallError
}

//******************************************************************************
// ネットワーク更新ファイル・narの作成
//******************************************************************************

OnUpdatedataCreating
{
	□EventBegin
}

OnNarCreating
{
	□EventBegin
}

OnUpdatedataCreated
{
	"\0%(○サーフェス)\s[0]%(文言('net.created.dau'))\w9\w9\w9\w9%(○サーフェス)\e"
}

OnNarCreated
{
	"\0%(○サーフェス)\s[0]%(文言('net.created.nar',reference[2],reference[0]))\w9\w9\w9\w9%(○サーフェス)\e"
}

//******************************************************************************
// ネットワーク更新
//******************************************************************************

OnUpdateBegin
{
	□EventBegin
}

//------------------------------------------------------------------------------
// 更新ファイルの一覧を取得した。reference[0] から更新ファイルの数を求めて知らせる
//------------------------------------------------------------------------------
OnUpdateReady
{
	_file = TOINT(reference[0]) + 1

	"\0\s[0]%(fcl)”%(_file)”\f[color,default] update file"
	--
	if _file > 1 {
		"s"
	}
	--
	"\e"
}

//------------------------------------------------------------------------------
// 更新ファイルのダウンロード開始。reference[0] はファイル名
//------------------------------------------------------------------------------
OnUpdate.OnDownloadBegin
{
	"\0\s[6]\_qloading %(fcl)”%(reference[0])”\f[color,default]\_q\e"
}

//------------------------------------------------------------------------------
// ネットワーク更新の完了。reference[0] が none なら更新ファイルは無かった。reference[3] を添えて知らせる
//------------------------------------------------------------------------------
OnUpdateComplete
{
	if reference[0] == "none" {
		"\0\s[0]%(reference[3]) no update file\w9\w9\w9\w9%(○サーフェス)\e"
	}
	else {
		"\0\s[0]%(reference[3]) update complete\w9\w9\w9\w9%(○サーフェス)\e"
	}
}

OnUpdateFailure
{
	"\0\s[6]%(reference[3]) update-failure\w9\w9\w9\w9%(○サーフェス)\b[-1]\e"
}

//******************************************************************************
// 共通の応答
//******************************************************************************

//------------------------------------------------------------------------------
// 処理の開始を知らせて待たせる。出ているヘルプメニューは消える
//------------------------------------------------------------------------------
□EventBegin
{
	"\0\s[6]waiting\w7.\w7.\w7.\e"
	--
	□ヘルプメニュー消滅した
}

//------------------------------------------------------------------------------
// 通信に失敗したことを知らせる
//------------------------------------------------------------------------------
□ConnectError
{
	"\0\s[6]connect-error\w9\w9\w9\w9%(○サーフェス)\b[-1]\e"
}

//------------------------------------------------------------------------------
// インストールに失敗したことを知らせる
//------------------------------------------------------------------------------
□InstallError
{
	"\0\s[6]install-error\w9\w9\w9\w9%(○サーフェス)\b[-1]\e"
}
