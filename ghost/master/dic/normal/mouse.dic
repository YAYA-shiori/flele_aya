//******************************************************************************
// FLELE
// マウス操作（クリック・ダブルクリック・なで・The Hand）
//******************************************************************************

//------------------------------------------------------------------------------
// クリック。当たり判定の名前（reference[4]）が o_ で始まるクリックは、o_ を外してボタンの操作として扱う。
// 曲リストメニューが有効なら、menu ボタンの右クリックで曲リストメニュー（Weirds.dll）を出す
//------------------------------------------------------------------------------
OnMouseClick
{
	if STRSTR(reference[4],"o_",0) == 0 && reference[5] != 1 {
		reference[4] = ERASE(reference[4],0,2)
		□クリック判定
	}
	elseif ○曲リストメニュー == "ON" {
		void SAORI("saori\Weirds.dll", "menu_close")
		if reference[5] == 1 && reference[4] == "menu" {
			"\0"
			--
			□weirds
		}
		elseif reference[5] == 1 && reference[4] == "o_menu" {
			"\0"
			--
			□weirds
		}
	}
}

//------------------------------------------------------------------------------
// ダブルクリック。The Hand 以外では、クリックと同じくボタンの操作として扱う
//------------------------------------------------------------------------------
OnMouseDoubleClick
{
	if basewarename != "The%(CHR(0x20))Hand" {
		□クリック判定
	}
}

//------------------------------------------------------------------------------
// 押されたボタン（当たり判定の名前）に応じた操作を行う
//------------------------------------------------------------------------------
□クリック判定
{
	_c = reference[4]
	reference[4] = 0
	case _c {
		when "stop_button1","stop_button2" {
			□演奏一時停止
		}
		when "k_window" {
			□曲名ウィンドウ表示
		}
		when "play_button" {
			□曲ランダム再生
		}
		when "clear_button" {
			□曲リストクリア
		}
		when "menu" {
			□メニュー
		}
		when "minimize" {
			□アイコン化
		}
		when "end_sect" {
			□終了する
		}
	}
}

//------------------------------------------------------------------------------
// カーソル移動。stroke_p（Sorcerer-F は stop_button1）の上を動かし続けると「なでた」と判断する
//------------------------------------------------------------------------------
OnMouseMove
{
	if reference[3] == 0 {
		//---- 本体側の撫で
		if reference[4] != "" {
			//---- どこかが撫でられている
			stroke++
			//---- 撫でられた量が一定量に達したら「なでられている」と判断
			if stroke >= 80 {
				//---- 撫でられた。撫でられた部位を見てトークする
				if reference[4] == "stroke_p" {
					□撫で反応
				}
				elseif ○現在シェル == "Sorcerer-F" && reference[4] == "stop_button1" {
					□撫で反応
				}
				stroke = 0
			}
		}
		else {
			// 定義された部位はどこも撫でられていない
			stroke = 0
		}
	}
}

//------------------------------------------------------------------------------
// なでられたときの反応。照れて、しばらく待ってから元のサーフェスにもどる
//------------------------------------------------------------------------------
□撫で反応
{
	"\0\s[1]\w5‥\w5‥\w5‥\w9\w9\w9\w9\w9\w9\w9\w9\w9%(○サーフェス)\b[-1]\e"
}

//------------------------------------------------------------------------------
// The Hand でさわられたときの反応
//------------------------------------------------------------------------------
OnHandActivate
{
	//　さわりはじまった
	if reference[0] == "NormalStart" {
		//　ダブルクリックはセリフ変更
		if reference[2] == "OnMouseDoubleClick" {
			"\0\b[-1]\w9\w9\b[1]\c…\w2…\w2…\w2…\w2…\w2…\w2。\w9\w9\e"
		}
		//　ダブルクリック以外
		else {
			"\0\b[-1]\w9\w9\w9\w9\b[1]\c…\w2…\w2…\w2。\e"
		}
	}
	//　ダブルクリックし終わった
	elseif reference[0] == "NormalEnd" && reference[2] == "OnMouseDoubleClick" {
		"\0%(○サーフェス)\s[0]\b[-1]\w9\b[1]…\w7…\w7…\w7…\w7…\w7…\w7。\w9\w9\w9\w9%(○サーフェス)\e"
	}
}
