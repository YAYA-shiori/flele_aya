//******************************************************************************
// FLELE
// SSPとの基本的なやりとり（選択肢・アンカー・ウィンドウ情報・ゴースト間通信・リソースの問い合わせ）
//******************************************************************************

//------------------------------------------------------------------------------
// 選択肢の選択。選択肢のIDは呼び出す関数の名前なので、そのまま実行する
//------------------------------------------------------------------------------
OnChoiceSelect
{
	//---- RSSの記事のリンク（ID は ASC(4) + RSSURL_ + URL）
	if "%(ASC(4))RSSURL_" _in_ reference[0] {
		"\C"
		--
		□RSSURLジャンプ
	}
	//---- キーコンフィグで選んだキー（ID は □key_ + キー名）
	elseif "□key_" _in_ reference[0] {
		□キー選択
	}
	else {
		EVAL(reference[0])
	}
}

//------------------------------------------------------------------------------
// アンカーの選択。選択肢と同様、IDの名前の関数を実行する
//------------------------------------------------------------------------------
OnAnchorSelect
{
	EVAL(reference[0])
}

//------------------------------------------------------------------------------
// SSPが通知するウィンドウハンドル（Weirds.dll に渡す）
//------------------------------------------------------------------------------
On_hwnd
{
	○hwnd = SPLIT(reference[0],CHR(1))[0]
}

//------------------------------------------------------------------------------
// SSPが通知するゴーストの固有ID（Weirds.dll に渡す）
//------------------------------------------------------------------------------
On_uniqueid
{
	○uniqueid = reference[0]
}

//------------------------------------------------------------------------------
// 秒ごとのイベント。このゴーストは自分からは話さないので何もしない
//------------------------------------------------------------------------------
OnSecondChange
{
}

//------------------------------------------------------------------------------
// 他のゴーストからの話しかけ。音楽の再生をお願いされたら演奏を始める
//------------------------------------------------------------------------------
OnCommunicate
{
	if reference[0] != "user" && reference[0] != "User" {
		if "音楽" _in_ reference[1] || "サウンド" _in_ reference[1] || "曲" _in_ reference[1] {
			if "再生" _in_ reference[1] || "演奏" _in_ reference[1] || "かけて" _in_ reference[1] || "歌って" _in_ reference[1] {
				// 応答の Reference0 を空にする
				res_reference[0] = ""
				//トークの後ろにつなぐので、演奏中に付く先頭の \C は外す
				_s = □曲ランダム再生
				if SUBSTR(_s,0,2) == "\C" {
					_s = ERASE(_s,0,2)
				}
				"\0\s[0]\c…\w7…\w7…。\w9\w9\w5\b[-1]\s[25]\w9%(_s)"
			}
		}
	}
}

//******************************************************************************
// SSPが問い合わせる文字列リソース（ボタンの表示・リンク・ネットワーク更新のURL）
//
// On_名前 の関数が、SSPのリソース「名前」の値を返す
//******************************************************************************

//------------------------------------------------------------------------------
// リソース tooltip。シェル上でマウスカーソルが止まったときのツールチップ。
// reference[4] が当たり判定の名前（o_ で始まるものはボタンとして扱う）。
// 当たり判定のない場所ではメニューの出し方を教え、なで用の stroke_p では何も出さない
//------------------------------------------------------------------------------
On_tooltip
{
	_c = reference[4]
	if STRSTR(_c,"o_",0) == 0 {
		_c = ERASE(_c,0,2)
	}
	case _c {
		when "stop_button1","stop_button2" {
			if ○演奏中 == 1 {
				"一時停止%(□キー表示(1))"
			}
			elseif ○一時停止中 == 1 {
				"再開%(□キー表示(1))"
			}
			else {
				"前回の曲を演奏%(□キー表示(1))"
			}
		}
		when "play_button" {
			"曲を演奏%(□キー表示(0))"
		}
		when "clear_button" {
			"曲リストをクリア%(□キー表示(4))"
		}
		when "k_window" {
			"曲名ウィンドウの表示/非表示%(□キー表示(3))"
		}
		when "menu" {
			"メニュー%(□キー表示(2))"
		}
		when "minimize" {
			"最小化"
		}
		when "end_sect" {
			"終了%(□キー表示(5))"
		}
		when "stroke_p" {
		}
		others {
			"ダブルクリックでメニュー%(□キー表示(2))"
		}
	}
}

//------------------------------------------------------------------------------
// ツールチップに添える、ショートカットキー（○キー設定[引数0]）の案内。キーが空なら何も返さない
//------------------------------------------------------------------------------
□キー表示
{
	_k = ○キー設定[_argv[0]]
	if _k != "" {
		"（キー: %(TOUPPER(_k))）"
	}
}

//------------------------------------------------------------------------------
// リソース useorigin1 に 0 を返す
//------------------------------------------------------------------------------
On_useorigin1
{
	"0"
}

