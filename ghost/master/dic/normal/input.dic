//******************************************************************************
// FLELE
// マウス操作（クリック・ダブルクリック・なで・The Hand）とキー操作・ホットキー（hotkey.dll）
//******************************************************************************

//------------------------------------------------------------------------------
// クリック。当たり判定の名前（reference[4]）が o_ で始まるクリックは、o_ を外してボタンの操作として扱う。
// 曲リストメニューが有効なら、menu ボタンの右クリックで曲リストメニュー（Weirds.dll）を出す
//------------------------------------------------------------------------------
OnMouseClick
{
	if STRSTR(reference[4],"o_",0) == 0 && reference[5] != 1 {
		reference[4] = ERASE(reference[4],0,2)
		□クリック判定
	}
	elseif ○曲リストメニュー == "ON" {
		void SAORI("saori\Weirds.dll", "menu_close")
		if reference[5] == 1 && reference[4] == "menu" {
			"\0"
			--
			□weirds
		}
		elseif reference[5] == 1 && reference[4] == "o_menu" {
			"\0"
			--
			□weirds
		}
	}
}

//------------------------------------------------------------------------------
// ダブルクリック。当たり判定のない場所を左ダブルクリックしたらメニューを出し入れする。
// 当たり判定の上なら、クリックと同じくボタンの操作として扱う
//------------------------------------------------------------------------------
OnMouseDoubleClick
{
	if reference[4] == "" {
		if reference[5] != 1 {
			□メニュー
		}
	}
	else {
		□クリック判定
	}
}

//------------------------------------------------------------------------------
// 押されたボタン（当たり判定の名前）に応じた操作を行う
//------------------------------------------------------------------------------
□クリック判定
{
	_c = reference[4]
	reference[4] = 0
	case _c {
		when "stop_button1","stop_button2" {
			□演奏一時停止
		}
		when "k_window" {
			□曲名ウィンドウ表示
		}
		when "play_button" {
			□曲ランダム再生
		}
		when "clear_button" {
			□曲リストクリア
		}
		when "menu" {
			□メニュー
		}
		when "minimize" {
			"\0\![set,windowstate,minimize]\e"
		}
		when "end_sect" {
			"\0\![raise,On_終了する]"
		}
	}
}

//------------------------------------------------------------------------------
// カーソル移動。stroke_p（Sorcerer-F は stop_button1）の上を動かし続けると「なでた」と判断する
//------------------------------------------------------------------------------
OnMouseMove
{
	if reference[3] == 0 {
		//---- 本体側の撫で
		if reference[4] != "" {
			//---- どこかが撫でられている
			stroke++
			//---- 撫でられた量が一定量に達したら「なでられている」と判断
			if stroke >= 80 {
				//---- 撫でられた。撫でられた部位を見てトークする
				if reference[4] == "stroke_p" {
					□撫で反応
				}
				elseif ○現在シェル == "Sorcerer-F" && reference[4] == "stop_button1" {
					□撫で反応
				}
				stroke = 0
			}
		}
		else {
			// 定義された部位はどこも撫でられていない
			stroke = 0
		}
	}
}

//------------------------------------------------------------------------------
// なでられたときの反応。照れて、しばらく待ってから元のサーフェスにもどる
//------------------------------------------------------------------------------
□撫で反応
{
	"\0\s[1]\w5‥\w5‥\w5‥\w9\w9\w9\w9\w9\w9\w9\w9\w9%(○サーフェス)\b[-1]\e"
}

//------------------------------------------------------------------------------
// The Hand でさわられたときの反応
//------------------------------------------------------------------------------
OnHandActivate
{
	//　さわりはじまった
	if reference[0] == "NormalStart" {
		//　ダブルクリックはセリフ変更
		if reference[2] == "OnMouseDoubleClick" {
			"\0\b[-1]\w9\w9\b[1]\c…\w2…\w2…\w2…\w2…\w2…\w2。\w9\w9\e"
		}
		//　ダブルクリック以外
		else {
			"\0\b[-1]\w9\w9\w9\w9\b[1]\c…\w2…\w2…\w2。\e"
		}
	}
	//　ダブルクリックし終わった
	elseif reference[0] == "NormalEnd" && reference[2] == "OnMouseDoubleClick" {
		"\0%(○サーフェス)\s[0]\b[-1]\w9\b[1]…\w7…\w7…\w7…\w7…\w7…\w7。\w9\w9\w9\w9%(○サーフェス)\e"
	}
}

//******************************************************************************
// キー操作とホットキー（hotkey.dll）
//******************************************************************************

//------------------------------------------------------------------------------
// ショートカットキー（○キー設定の先頭6つ）をhotkey.dllに登録する
//------------------------------------------------------------------------------
□ホットキー準備
{
	for _i = 0 ; _i < 6 ; _i++ {
		void SAORI("saori\hotkey.dll", ○キー設定[_i], "flele", "none")
	}
}

//------------------------------------------------------------------------------
// hotkey.dllに登録したホットキーをすべて解除する
//------------------------------------------------------------------------------
□ホットキー停止
{
	void SAORI("saori\hotkey.dll")
}

//------------------------------------------------------------------------------
// ゴーストがアクティブなときのキー入力。Weirds.dllにも伝える
//------------------------------------------------------------------------------
OnKeyPress
{
	void SAORI("saori\Weirds.dll", "notify_keypress", reference[0])
	txt = reference[0]
	□キー判定
}

//------------------------------------------------------------------------------
// ゴーストが非アクティブなときのホットキー（Ctrl + Shift + キー）
//------------------------------------------------------------------------------
OnHotKeyPress
{
	txt = reference[0]
	□キー判定
}

//------------------------------------------------------------------------------
// 押されたキー（txt）に割り当てられた操作を行う。
// 割り当ては左から 曲再生 / 一時停止 / メニュー / 曲名ウィンドウ / 曲クリア / 終了
//------------------------------------------------------------------------------
□キー判定
{
	// 全角の￥は \ として扱う
	if txt == "￥" {
		txt = "\"
	}

	if txt == ○キー設定[0] {
		□曲ランダム再生
	}
	elseif txt == ○キー設定[1] {
		□演奏一時停止
	}
	elseif txt == ○キー設定[2] {
		□メニュー
	}
	elseif txt == ○キー設定[3] {
		□曲名ウィンドウ表示
	}
	elseif txt == ○キー設定[4] {
		□曲リストクリア
	}
	elseif txt == ○キー設定[5] {
		"\0\![raise,On_終了する]"
	}
}
