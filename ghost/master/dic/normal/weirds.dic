//******************************************************************************
// FLELE
// 曲リストメニュー（Weirds.dll）と曲名ウィンドウ（bln.dll）
//
// 曲名メニューの項目は、ASC(1) 区切りで ASC(2) で終わる文字列。
// 曲ごとの項目には、ASC(4)（メニューに出す名前）と ASC(5)（呼ぶイベント名の末尾）の位置に、
// 「再生」「情報」「フォルダを開く」「削除」を埋めて On_weirds曲再生 などのイベントを呼ぶ。
// イベント名の末尾は表示する言語によらず日本語のまま（表示する名前だけを言語に合わせる）
//******************************************************************************

//------------------------------------------------------------------------------
// 曲リストメニュー（曲の一覧と再生方法の選択）を、Weirds.dllで表示する
//------------------------------------------------------------------------------
□weirds
{
	○ヘルプメニュー表示中 = 0
	void SAORI("saori\Weirds.dll", "show", "/
		//メニュー
		%(ASC(1))%(ASC(1))　- music list -%(ASC(1))Dummy%(ASC(2))/
		%(ASC(1))%(ASC(1))%(ASC(1))Separator%(ASC(2))/
		%(○weirds曲メニュー)/
		","/
		//デザイン
		background.font.color%(ASC(1))0,0,0%(ASC(2))/
		background.base.color%(ASC(1))255,255,255%(ASC(2))/
		foreground.font.color%(ASC(1))%(mffc)%(ASC(2))/
		foreground.base.color%(ASC(1))%(mfbc)%(ASC(2))/
		menu.disable.font.color%(ASC(1))150,150,150%(ASC(2))/
		menu.item.fontname%(ASC(1))MS UI Gothic%(ASC(2))/
		sidebar.base.color%(ASC(1))255,255,255%(ASC(2))/
		menu.item.width%(ASC(1))100%(ASC(2))/
		sidebar.width%(ASC(1))0%(ASC(2))/
		")
	--
	"\e"
}

//------------------------------------------------------------------------------
// 曲リストメニューの項目。曲ごとの 再生 / 情報 / フォルダを開く / 削除 と、再生方法の選択肢を並べる
//------------------------------------------------------------------------------
○weirds曲メニュー
{
	if ○曲の数 >= 1 {
		//キャッシュ更新
		if ○曲リスト更新 != 0 {
			□weirdsリスト生成
		}
		--
		"/

			%(□weirds曲項目('再生','weirds.play'))/

			%(□weirds曲項目('情報','weirds.info'))/

			%(□weirds曲項目('フォルダを開く','weirds.open_folder'))/

			%(□weirds曲項目('削除','weirds.delete'))/

			"
	}
	else {
		"%(ASC(1))%(ASC(1))　　 no data%(ASC(1))Dummy%(ASC(2))"
	}
	--
	"%(ASC(1))%(ASC(1))%(ASC(1))Separator%(ASC(2))"
	--
	□weirds音量メニュー
	--
	"%(ASC(1))%(ASC(1))%(ASC(1))Separator%(ASC(2))"
	--
	□weirds再生法(文言('weirds.mode.random'),"random")
	--
	□weirds再生法(文言('weirds.mode.seq_loop'),"seq_loop")
	--
	□weirds再生法(文言('weirds.mode.seq_one'),"seq_one")
	--
	□weirds再生法(文言('weirds.mode.one'),"one")
	--
	□weirds再生法(文言('weirds.mode.loop'),"loop")
	--
}

//------------------------------------------------------------------------------
// 曲リストの全曲について、1つの操作（再生・情報・フォルダを開く・削除）の項目を並べたもの。
//   _argv[0]: 呼ぶイベント名の末尾（On_weirds曲 の後ろにつく日本語）  _argv[1]: メニューに出す名前の文言のキー
//------------------------------------------------------------------------------
□weirds曲項目
{
	REPLACE(REPLACE(○weirdsリスト,ASC(5),_argv[0]),ASC(4),文言(_argv[1]))
}

//------------------------------------------------------------------------------
// 音量の選択肢（100から0まで10刻み）。選ぶと On_weirds音量調節 が呼ばれる。現在の音量には印（C）を付ける。
// 100・50・0 は目盛り代わりに数字を添える
//------------------------------------------------------------------------------
□weirds音量メニュー
{
	_menu = ""
	for _v = 100 ; _v >= 0 ; _v -= 10 {
		_mark = ""
		if TOINT(○音量) == _v {
			_mark = "C"
		}
		_label = "+"
		if _v == 100 || _v == 50 || _v == 0 {
			_label = "+-  %(_v)"
		}
		_ref = _v
		if _v == 0 {
			_ref = "OFF"
		}
		_menu += "volume%(ASC(1))%(_mark)%(ASC(1))%(_label)%(ASC(1))Event%(ASC(1))On_weirds音量調節%(ASC(1))%(_ref)%(ASC(2))"
	}
	_menu
}

//------------------------------------------------------------------------------
// 音量の選択肢が選ばれた。reference[0] が新しい音量（0〜100。0 は OFF）。
// 演奏中なら、その場で音量を変える
//------------------------------------------------------------------------------
On_weirds音量調節
{
	if reference[0] == "OFF" {
		○音量 = 0
	}
	else {
		○音量 = TOINT(reference[0])
	}
	_script = □音量を反映
	if _script != "" {
		"\C" + _script + "\e"
	}
}

//------------------------------------------------------------------------------
// 再生方法の選択肢1つぶんの項目。選ぶと On_再生法変更 が呼ばれる。現在の再生方法には印（C）を付けて選べなくする
//   _argv[0]: 表示する名前
//   _argv[1]: 再生方法（○演奏法 の値）
//------------------------------------------------------------------------------
□weirds再生法
{
	"%(文言('weirds.mode.folder'))%(ASC(1))"
	--
	if ○演奏法 == _argv[1] {
		"C"
	}
	elseif ISVAR("○演奏法") == 0 && _argv[1] == "random" {
		"C"
	}
	--
	"%(ASC(1))%(_argv[0])%(ASC(1))"
	--
	if ○演奏法 == _argv[1] {
		"Dummy"
	}
	elseif ISVAR("○演奏法") == 0 && _argv[1] == "random" {
		"Dummy"
	}
	else {
		"Event"
	}
	--
	"%(ASC(1))On_再生法変更%(ASC(1))%(_argv[1])%(ASC(2))"
}

//------------------------------------------------------------------------------
// 曲リストから、曲リストメニューの項目（○weirdsリスト）を作る。
// 25曲を超えるときは、25曲ずつのフォルダ（～ 25、～ 50、…）に分ける。
// 作り直しが済んだら○曲リスト更新を 0 に戻す
//------------------------------------------------------------------------------
□weirdsリスト生成
{
	ERASEVAR("○weirdsリスト")
	//○曲リスト配列の各要素値を順番に取り出し
	_c = 0
	//25曲以下ならフォルダにいれない
	if ○曲の数 <= 25 {
		foreach ○曲リスト ; _i {
			// ファイル名を曲名に
			_曲名 = SPLITPATH(_i)[2] + SPLITPATH(_i)[3]

			○weirdsリスト = ○weirdsリスト + ASC(4) + ASC(1) + ASC(1) + _曲名 + ASC(1) + "Event" + ASC(1) + "On_weirds曲%(ASC(5))" + ASC(1) + _c + ASC(2)
			_c++
		}
	}
	else {
		foreach ○曲リスト ; _i {
			// ファイル名を曲名に
			_曲名 = SPLITPATH(_i)[2] + SPLITPATH(_i)[3]
			_フォルダ = (_c / 25) * 25 + 25
			○weirdsリスト = ○weirdsリスト + ASC(4) + "\" + "～ " + _フォルダ + ASC(1) + ASC(1) + _曲名 + ASC(1) + "Event" + ASC(1) + "On_weirds曲%(ASC(5))" + ASC(1) + _c + ASC(2)
			_c++
		}
	}

	○曲リスト更新 = 0
}

//------------------------------------------------------------------------------
// メニューで選んだ曲（reference[0] は曲リストの0始まりの番号）を演奏する
//------------------------------------------------------------------------------
On_weirds曲再生
{
	○指定曲番号 = TOINT(reference[0]) + 1
	□曲ランダム再生
}

//------------------------------------------------------------------------------
// メニューで選んだ曲（reference[0] は曲リストの0始まりの番号）を曲リストから削除する。
// 演奏中の曲なら止め、ダウンロードした曲ならファイルも削除する
//------------------------------------------------------------------------------
On_weirds曲削除
{
	_idx = TOINT(reference[0])
	if _idx < 0 || _idx >= ○曲の数 {
		return
	}
	_path = ○曲リスト[_idx]
	_script = ''
	//演奏中（一時停止中も含む）の曲なら止める
	if ○演奏中曲パス == _path {
		ERASEVAR('○演奏中曲パス')
		_script = □演奏ストップ
	}
	//前にある曲を消したら演奏中の曲番号を詰める
	elseif _idx < ○演奏中曲No - 1 {
		○演奏中曲No = ○演奏中曲No - 1
	}
	//ダウンロード曲だったらファイルも削除（再生中で消せなければ止まってから消す）
	_d = ASEARCH(_path,○ダウンロード曲リスト)
	if _d != -1 {
		void □ファイル削除予約(_path)
		if ARRAYSIZE(○ダウンロード曲リスト) <= 1 {
			○ダウンロード曲リスト = IARRAY
		}
		else {
			○ダウンロード曲リスト[_d] = IARRAY
		}
	}
	if ○曲の数 <= 1 {
		○曲リスト = IARRAY
	}
	else {
		○曲リスト[_idx] = IARRAY
	}
	○曲リスト更新 = 1
	void □曲名ウィンドウONなら表示
	_script + □削除待ち処理予約
}

//------------------------------------------------------------------------------
// メニューで選んだ曲（reference[0] は曲リストの0始まりの番号）の情報を表示する
//------------------------------------------------------------------------------
On_weirds曲情報
{
	○path = ○曲リスト[reference[0]]
	○No = reference[0] + 1
	□weirds曲情報
}

//------------------------------------------------------------------------------
// 曲情報の画面（○path の曲、○No は曲リストでの番号）
//------------------------------------------------------------------------------
□weirds曲情報
{
	○イベント名 = "□weirds曲情報"
	□メニューヘッダ
	--
	文言('weirds.info.title')
	--
	□曲情報中身
	--
	"\n[half]/
		\n　　　　　　　　\q[CLOSE,□close]\e"
}

//------------------------------------------------------------------------------
// メニューで選んだ曲（reference[0] は曲リストの0始まりの番号）のあるフォルダを開く。
// ダウンロードした曲は sound_file フォルダを開く
//------------------------------------------------------------------------------
On_weirds曲フォルダを開く
{
	_path = ○曲リスト[reference[0]]
	_dpath = SPLITPATH(_path)[0] + SPLITPATH(_path)[1]
	if _dpath == "..\..\..\sound_file\" {
		_dpath = "..\..\sound_file"
	}
	else {
		// 末尾の \ を落とす
		_i = STRLEN(_dpath) - 1
		_dpath = SUBSTR(_dpath,0,_i)
	}
	"\0\![open,file,%(_dpath)]\e"
}

//------------------------------------------------------------------------------
// 再生方法の選択肢が選ばれた。reference[0] が新しい再生方法（○演奏法 の値）
//------------------------------------------------------------------------------
On_再生法変更
{
	○演奏法 = reference[0]
	"\0\e"
}

//******************************************************************************
// 曲名ウィンドウ（bln.dll）
//
// 演奏中の曲名を出す小さなウィンドウ。○曲名ウィンドウON が 1 のとき出す
//******************************************************************************

//------------------------------------------------------------------------------
// 曲名ウィンドウの表示・非表示を切り替える（ボタンとキーの操作）
//------------------------------------------------------------------------------
□曲名ウィンドウ表示
{
	if ○曲名ウィンドウON != 1 {
		○曲名ウィンドウON = 1
		void SAORI("saori\bln.dll", "win01", "%(○ウィンドウ表示用曲名)", "0", "0", "kyokumei")
	}
	else {
		□曲名ウィンドウ非表示
	}
}

//------------------------------------------------------------------------------
// 曲名ウィンドウを閉じる
//------------------------------------------------------------------------------
□曲名ウィンドウ非表示
{
	○曲名ウィンドウON = 0
	void SAORI("saori\bln.dll", "win01", "", "0", "0", "kyokumei")
}

//------------------------------------------------------------------------------
// 曲名ウィンドウの曲名を更新する
//------------------------------------------------------------------------------
□ウィンドウに曲名表示
{
	void SAORI("saori\bln.dll", "win01", "%(○ウィンドウ表示用曲名)", "0", "0", "kyokumei", "1")
}

//------------------------------------------------------------------------------
// 曲名ウィンドウをONにしているときだけ、曲名を更新する。
// 曲が替わったときや、最小化から復元したときなどに呼ぶ
//------------------------------------------------------------------------------
□曲名ウィンドウONなら表示
{
	if ○曲名ウィンドウON == 1 {
		□ウィンドウに曲名表示
	}
}

//------------------------------------------------------------------------------
// 曲名ウィンドウに表示する文字列。「曲番号/曲数 曲名」の形で、曲名は18文字で省略する。
// 演奏中でなければ「NO PLAYING」
//------------------------------------------------------------------------------
○ウィンドウ表示用曲名
{
	if ○演奏中 == 1 || ○一時停止中 == 1 {
		_ナンバー = ○演奏中曲No

		//　文字数18を越えると省略
		_表示曲名 = "%(○演奏中曲名)"
		if ○曲名文字数 > 18 {
			_抜き出し = SUBSTR("%(○演奏中曲名)",0,18)
			_表示曲名 = "%(_抜き出し)…"
		}

		// 曲No位置調整（桁数に応じた空白で、曲名の位置をそろえる）
		_曲No文字数 = STRLEN(_ナンバー)
		_空白 = "\_q"
		if _曲No文字数 == 1 {
			_空白 = "\_q　"
		}
		elseif _曲No文字数 == 2 {
			_空白 = "\_q%(CHR(0x20))"
		}

		//　表示
		"%(_空白)%(_ナンバー)/%(○曲の数)\_q %(_表示曲名)"
	}
	else {
		"\_q　0/%(○曲の数) - NO PLAYING -\_q"
	}
}

//------------------------------------------------------------------------------
// 曲名ウィンドウ（イージーバルーン）のダブルクリック。ウィンドウを閉じる（CROW非対応）
//------------------------------------------------------------------------------
OnEBMouseDoubleClick
{
	if reference[3] == "kyokumei" {
		□曲名ウィンドウ非表示
	}
}
