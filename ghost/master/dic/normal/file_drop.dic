//******************************************************************************
// FLELE
// ファイル・フォルダ・プレイリストのドロップによる曲の追加
//
// 追加する曲のパスは、いったん○AllFilepath（配列）に入れてから□ドロップファイル処理で曲リストへ移す
//******************************************************************************

//------------------------------------------------------------------------------
// ファイルがドロップされた（複数のときは CHR(1) 区切りで reference[0] に入る）
//------------------------------------------------------------------------------
OnFileDrop2
{
	○path = 0
	○path = reference[0]
	□ファイルがドロップされた
}

//------------------------------------------------------------------------------
// ○path に入っているドロップされたものを、フォルダ・プレイリスト・曲ファイルに分けて処理する
//------------------------------------------------------------------------------
□ファイルがドロップされた
{
	"\0"
	--
	//　ディレクトリかどうか判断
	if FATTRIB(○path)[2] == 1 {
		○ディレクトリ = 0
		○ディレクトリ = reference[0]
		□ディレクトリパス調整
	}

	//　ディレクトリじゃなかったらファイルとして処理
	else {
		○ディレクトリ = 0
		//　簡易配列を汎用配列へ変換
		○AllFilepath = SPLIT(○path, CHR(1))
		○path = ○AllFilepath[0]
		_拡張子 = TOLOWER(SPLITPATH(○path)[3])
		// m3uを投げられた
		if _拡張子 == ".m3u" || _拡張子 == ".pls" {
			□プレイリスト処理
		}
		else {
			□ドロップファイル処理
		}
	}
	--
	"\e"
}

//------------------------------------------------------------------------------
// フォルダがドロップされた
//------------------------------------------------------------------------------
OnDirectoryDrop
{
	○ディレクトリ = 0
	○ディレクトリ = reference[0]
	□ディレクトリドロップ処理
}

//------------------------------------------------------------------------------
// ドロップされたフォルダ（○path）を○ディレクトリにして、中の曲を追加する
//------------------------------------------------------------------------------
□ディレクトリパス調整
{
	○ディレクトリ = ○path
	□ディレクトリドロップ処理
}

//------------------------------------------------------------------------------
// ○ディレクトリ（末尾は \）の中のファイルを全て、曲リストに追加する
//------------------------------------------------------------------------------
□ディレクトリドロップ処理
{
	"\0\b[6]\b[-1]"
	--
	//　ディレクトリに入ってるファイルを全て配列保存（カンマを含むファイル名が割れないよう、区切りを \x01 にする）
	○AllFilepath = SPLIT(FENUM(○ディレクトリ, CHR(1)), CHR(1))
	--
	□ドロップファイル処理
	--
	"\e"
}

//------------------------------------------------------------------------------
// ○AllFilepath のうち、音楽ファイルで、まだ曲リストに入っていないものを曲リストに追加し、
// 追加した曲数を報告する。○ディレクトリが 0 でなければ、各ファイル名の前に付けてパスにする
//------------------------------------------------------------------------------
□ドロップファイル処理
{
	_追加した曲数 = 0
	_既に入ってた曲数 = 0
	//ドロップされたファイル配列の各要素値を順番に取り出し
	foreach ○AllFilepath ; _Filename {
		//音楽ファイルかどうか拡張子で判断
		_拡張子 = TOLOWER(SPLITPATH(_Filename)[3])
		if □音楽ファイルの拡張子か(_拡張子) {
			//ディレクトリパスが付いてなかったら付ける
			if ○ディレクトリ != 0 {
				_Filename = ○ディレクトリ + _Filename
			}

			//音楽ファイルならリストに入っているか判断(無い場合-1)
			if ASEARCH(_Filename,○曲リスト) == -1 {
				//入っていない曲ならリストに追加
				if ○曲の数 <= 0 {
					○曲リスト = _Filename
				}
				else {
					○曲リスト = (○曲リスト,_Filename)
				}
				_追加した曲数++
			}
			//既に入ってた曲なら何もしないでカウント
			else {
				_既に入ってた曲数++
			}
		}
	}
	//曲追加した場合曲数報告
	--
	if _追加した曲数 >= 1 {
		○曲リスト更新 = 1
		□ヘルプメニュー消滅した
		--
		if ○曲の数 == 1 {
			○曲リスト = ○曲リスト[0]
		}
		"\b[0]\c%(○サーフェス)\s[0]%(_追加した曲数)曲追加。\w5\n曲リストには全%(○曲の数)曲入ってます。"
		--
		if _追加した曲数 == 1 {
			"\n\n[half]　　 \q[PLAY,□ドロップ曲再生]｜\q[CLOSE,□close]"
		}
		--
		"\w9\w9\w9\w9%(○サーフェス)"
	}

	//曲追加できなかった
	else {
		□ヘルプメニュー消滅した
		--
		//既に入ってた曲を1つ以上ドロップされた
		if _既に入ってた曲数 > 0 {
			"\b[0]\s[0]その曲はもう既に入っています。\w9\w9\w9\w9%(○サーフェス)"
		}
		//音楽ファイルが1つも無かった
		else {
			"\b[0]\s[0]追加できる音楽ファイルがありませんでした。\w9\w9\w9\w9%(○サーフェス)"
		}
	}
	//　セーブ
	SAVEVAR
}

//------------------------------------------------------------------------------
// 追加した曲（曲リストの最後）をすぐに演奏する。追加の報告の［PLAY］から呼ばれる
//------------------------------------------------------------------------------
□ドロップ曲再生
{
	○指定曲番号 = ○曲の数
	□曲ランダム再生
}

//------------------------------------------------------------------------------
// プレイリスト（m3u / pls）○path を読み、中の曲のパスを○AllFilepathに集めて曲リストに追加する
//------------------------------------------------------------------------------
□プレイリスト処理
{
	void FOPEN(○path,"r")
	_txt = 0
	_i = 0
	○AllFilepath = IARRAY
	while _txt != -1 && _i < 5000 {
		_i++
		_txt = FREAD(○path)
		_d = _i - 2
		//先頭にFile*=がついてたら削除
		if STRSTR(_txt,"File%(_d)=",0) == 0 {
			_txt = REPLACE(_txt, "File%(_d)=", "")
		}
		//先頭に#EXTM3Uや#EXTINFや[playlist]がついてなかったら○AllFilepathに追加
		if STRSTR(_txt,"[playlist]",0) != 0 && STRSTR(_txt,"#EXTM3U:",0) != 0 && STRSTR(_txt,"#EXTINF:",0) != 0 && _txt != -1 {
			○AllFilepath = (○AllFilepath,_txt)
		}
	}
	FCLOSE(○path)
	if ARRAYSIZE(○AllFilepath) >= 1 {
		□ドロップファイル処理
	}
}
