//******************************************************************************
// FLELE
// ヘルプメニュー（トップ画面・演奏中の曲情報・設定画面）
//******************************************************************************

//------------------------------------------------------------------------------
// ヘルプメニューの各画面の先頭に付ける、バルーンの設定
// （メニュー用バルーン、自動スクロール無効、タグを文字として扱う）
//------------------------------------------------------------------------------
□メニューヘッダ
{
	"\0\b[2]\c\![set,autoscroll,disable]\*\_q"
}

//------------------------------------------------------------------------------
// メニューボタン・メニューキーの操作。メニューが出ていれば閉じ、出ていなければ出す
//------------------------------------------------------------------------------
□メニュー
{
	// 既にメニュー表示されてたら消す
	if ○ヘルプメニュー表示中 == 1 {
		○ヘルプメニュー表示中 = 0
		"\0\b[-1]\e"
	}
	else {
		// 表示されてなかったら表示
		□メニュー_index
	}
}

//------------------------------------------------------------------------------
// ヘルプメニューのトップ画面。曲数・演奏状態・キー操作表と、各画面へのリンクを並べる
//------------------------------------------------------------------------------
□メニュー_index
{
	○ヘルプメニュー表示中 = 1
	□メニューヘッダ
	--
	"\v%(menu_bg)"
	--
	if 'for flele'_in_○現在バルーン {
		"\_l[3,2]"
	}
	--
	// 曲インフォ -------------------------
	if ○曲の数 >=1 {
		文言n('menu.index.count',○曲の数)
		--
		if ○演奏中 == 1 {
			//　文字数12を越えたら省略
			_表示曲名 = "%(○演奏中曲名)"
			if ○曲名文字数 > 12 {
				_抜き出し = SUBSTR("%(○演奏中曲名)",0,12)
				_表示曲名 = "%(_抜き出し)…"
			}
			文言('menu.index.playing',_表示曲名)
		}
		elseif ○一時停止中 == 1 {
			文言('menu.index.paused')
		}
		else {
			文言('menu.index.stopped')
		}
	}
	else {
		文言('menu.index.count0')
	}
	--
	if ○現在バルーン=='for flele' {
		"\_l[0,94]"
	}
	elseif ○現在バルーン=='for flele / wide' {
		"\_l[0,110]"
	}
	else {
		'\n\n'
	}
	--
	// キーインフォ -------------------------
	文言('menu.index.keys',キー設定表示名(0),キー設定表示名(1),キー設定表示名(2),キー設定表示名(3),キー設定表示名(4),キー設定表示名(5),キー設定表示名(6),キー設定表示名(7))

	--
	// 1段目 -------------------------
	文言('menu.index.row1')
	--
	if ○曲の数 >= 1 && ○起動中演奏回 >= 1 {
		文言('menu.index.row1_songinfo')
	}
	--

	// 2段目 -------------------------
	文言('menu.index.row2')
	--

	// 3段目 -------------------------
	文言('menu.index.row3')
	--
	if ARRAYSIZE(○ダウンロード曲リスト) > 0 {
		文言('menu.index.row3_dlfolder')
	}
	--

	// 4段目 -------------------------
	文言('menu.index.row4')
	--
	// ナビ -------------------------
	"\n\n　　　　　　　　\q[CLOSE,□close]\e"
}

//------------------------------------------------------------------------------
// 説明書（README.md）をSSPで開く
//------------------------------------------------------------------------------
□readme開く
{
	"\c\![open,readme]"
	--
	□ヘルプメニュー消滅した
}

//------------------------------------------------------------------------------
// 演奏中の曲の情報を表示する。［RELOAD］で表示し直す
//------------------------------------------------------------------------------
□現在曲情報
{
	○path = ○演奏中曲絶対パス
	○No = ○演奏中曲No
	○イベント名 = "□現在曲情報"
	□メニューヘッダ
	--
	文言('menu.songinfo.title')
	--
	□曲情報中身
	--
	"\n[half]/
		\n　　　　　　 \q[［RELOAD］,□現在曲情報]\n\n[half]/
		\n　　　　　　\q[CLOSE,□close]｜\q[BACK,□メニュー_index]\e"
}

//------------------------------------------------------------------------------
// 曲の情報の本体。○path の曲のタグとファイルの情報を並べる。○No は曲リストでの番号。
// ファイルが無いときは、曲リストに入っているパスだけを示す
//------------------------------------------------------------------------------
□曲情報中身
{
	_path = 絶対パス変換(○path)
	if FATTRIB(_path) == -1 {
		"%(fcl)%(文言('menu.songinfo.missing'))\f[color,default]\n/
			%(fcl)Number　 \f[color,default]: %(○No)　( Total %(○曲の数) )\n/
			%(fcl)Filepath \f[color,default]: \_!%(○path)\_!\n/
			"
	}
	else {
		_m = □メディア情報(_path)
		"/
			%(fcl)number　 \f[color,default]: %(○No)　( Total %(○曲の数) )\n/
			%(fcl)title　　\f[color,default]: \_!%(_m[0])\_!\n/
			%(fcl)artist 　\f[color,default]: \_!%(_m[1])\_!\n/
			%(fcl)genre 　 \f[color,default]: \_!%(_m[3])\_!\n/
			%(fcl)year 　　\f[color,default]: \_!%(_m[4])\_!\n/
			%(fcl)filepath \f[color,default]: \_!%(_path)\_!\n/
			%(fcl)filesize \f[color,default]: %(○現在曲サイズ)\n/
			%(fcl)comment　\f[color,default]: \_!%(_m[6])\_!\n/
			"
	}
}

//------------------------------------------------------------------------------
// メニューの［CLOSE］。バルーンを閉じて、歌っているサーフェスにもどす
//------------------------------------------------------------------------------
□close
{
	"\0\b[-1]\w9\w9\w9%(○サーフェス)\e"
	--
	□ヘルプメニュー消滅した
}

//------------------------------------------------------------------------------
// ヘルプメニューが画面から消えたことを覚える（○ヘルプメニュー表示中 を 0 にする）。
// バルーンが閉じられるなど、メニューが消える場面から呼ぶ
//------------------------------------------------------------------------------
□ヘルプメニュー消滅した
{
	○ヘルプメニュー表示中 = 0
}

//******************************************************************************
// ヘルプメニューの設定画面（動作設定・再生方法）
//******************************************************************************

//------------------------------------------------------------------------------
// 設定のトップ画面。再生の設定と動作設定へのリンクを並べる
//------------------------------------------------------------------------------
□設定
{
	□メニューヘッダ
	--
	文言('menu.settings.title')
	--

	"\_b[img\icon_point.png,inline] %(fcl)%(fcc)\q[%(文言('menu.settings.playback')),□再生設定]\f[color,default]\f[cursorfontcolor,default]\n\n[half]"
	--
	"\_b[img\icon_point.png,inline] %(fcl)%(fcc)\q[%(文言('menu.settings.behavior')),□動作設定]\f[color,default]\f[cursorfontcolor,default]\n\n"
	--

	"\n　　　　　　　\q[CLOSE,□close]｜\q[BACK,□メニュー_index]\e"
}

//------------------------------------------------------------------------------
// 動作設定の画面。ホットキー操作と曲リストメニューのON/OFFを切り替える
//------------------------------------------------------------------------------
□動作設定
{
	□メニューヘッダ
	--
	文言('menu.behavior.title')
	--

	文言('menu.behavior.hotkey')
	--
	if ○ホットキー操作=="ON" {
		"　　　　%(fcl)ON\f[color,default] ［\q[%(文言('menu.change')),□ホットキーOFF]］"
	}
	else {
		"　　　　%(fcl)OFF\f[color,default]［\q[%(文言('menu.change')),□ホットキーON]］"
	}
	--
	文言('menu.behavior.listmenu')
	--
	if ○曲リストメニュー=="ON" {
		"　　　　%(fcl)ON\f[color,default] ［\q[%(文言('menu.change')),□曲リストメニューOFF]］"
	}
	else {
		"　　　　%(fcl)OFF\f[color,default]［\q[%(文言('menu.change')),□曲リストメニューON]］"
	}
	--

	"\n\n[half]/
		\n　　　　　　　\q[CLOSE,□close]｜\q[BACK,□設定]\e"
}

//------------------------------------------------------------------------------
// ホットキー操作をOFFにする。hotkey.dllの登録を解除し、SHIORIを再読み込みして反映する
//------------------------------------------------------------------------------
□ホットキーOFF
{
	○ホットキー操作 = "OFF"
	□ホットキー停止
	--
	"\![reload,shiori]"
	--
	□動作設定
}

//------------------------------------------------------------------------------
// ホットキー操作をONにする。hotkey.dllに登録し、SHIORIを再読み込みして反映する
//------------------------------------------------------------------------------
□ホットキーON
{
	○ホットキー操作 = "ON"
	□ホットキー準備
	--
	"\![reload,shiori]"
	--
	□動作設定
}

//------------------------------------------------------------------------------
// 曲リストメニュー（右クリックで出るメニュー）を使わない設定にする
//------------------------------------------------------------------------------
□曲リストメニューOFF
{
	○曲リストメニュー = "OFF"
	□動作設定
}

//------------------------------------------------------------------------------
// 曲リストメニュー（右クリックで出るメニュー）を使う設定にする
//------------------------------------------------------------------------------
□曲リストメニューON
{
	○曲リストメニュー = "ON"
	□動作設定
}

//------------------------------------------------------------------------------
// 再生方法の画面。［変更］を押すたびに 一度だけ → 同じ曲を繰り返し → ランダム → リスト順に繰り返し → リスト順に一周 の順で切り替える
//------------------------------------------------------------------------------
□再生設定
{
	□メニューヘッダ
	--
	文言('menu.playback.title')
	--
	文言('menu.playback.mode_label')
	--
	case ○演奏法 {
		when "one" {
			"　　 %(fcl)%(文言('menu.playback.one'))\f[color,default]［\q[%(文言('menu.change')),□演奏法loop]］"
		}
		when "loop" {
			"　　 %(fcl)%(文言('menu.playback.loop'))\f[color,default]［\q[%(文言('menu.change')),□演奏法random]］"
		}
		when "seq_loop" {
			"　　 %(fcl)%(文言('menu.playback.seq_loop'))\f[color,default]［\q[%(文言('menu.change')),□演奏法seq_one]］"
		}
		when "seq_one" {
			"　　 %(fcl)%(文言('menu.playback.seq_one'))\f[color,default]［\q[%(文言('menu.change')),□演奏法one]］"
		}
		others {
			"　　 %(fcl)%(文言('menu.playback.random'))\f[color,default]［\q[%(文言('menu.change')),□演奏法seq_loop]］"
		}
	}
	--
	文言('menu.playback.volume_label')
	--
	"　　 %(fcl)%(○音量)\f[color,default]　［\q[－,□音量下げ]］［\q[＋,□音量上げ]］"
	--
	"\n\n\n[half]　　　　　　　\q[CLOSE,□close]｜\q[BACK,□設定]\e"
}

//------------------------------------------------------------------------------
// 音量を10下げる（0が下限）。演奏中なら、その場で音量を変えて再生設定の画面にもどる
//------------------------------------------------------------------------------
□音量下げ
{
	○音量 = TOINT(○音量) - 10
	if ○音量 < 0 {
		○音量 = 0
	}
	□音量を反映
	--
	□再生設定
}

//------------------------------------------------------------------------------
// 音量を10上げる（100が上限）。演奏中なら、その場で音量を変えて再生設定の画面にもどる
//------------------------------------------------------------------------------
□音量上げ
{
	○音量 = TOINT(○音量) + 10
	if ○音量 > 100 {
		○音量 = 100
	}
	□音量を反映
	--
	□再生設定
}

//------------------------------------------------------------------------------
// 再生方法を「同じ曲をエンドレス」にする
//------------------------------------------------------------------------------
□演奏法loop
{
	○演奏法 = "loop"
	□再生設定
}

//------------------------------------------------------------------------------
// 再生方法を「ランダムでエンドレス」にする
//------------------------------------------------------------------------------
□演奏法random
{
	○演奏法 = "random"
	□再生設定
}

//------------------------------------------------------------------------------
// 再生方法を「一曲を一度だけ」にする
//------------------------------------------------------------------------------
□演奏法one
{
	○演奏法 = "one"
	□再生設定
}

//------------------------------------------------------------------------------
// 再生方法を「リスト順にエンドレス」にする
//------------------------------------------------------------------------------
□演奏法seq_loop
{
	○演奏法 = "seq_loop"
	□再生設定
}

//------------------------------------------------------------------------------
// 再生方法を「リスト順に一周だけ」にする
//------------------------------------------------------------------------------
□演奏法seq_one
{
	○演奏法 = "seq_one"
	□再生設定
}
