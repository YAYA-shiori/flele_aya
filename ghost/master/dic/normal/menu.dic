//******************************************************************************
// FLELE
// ヘルプメニュー（トップ画面・演奏中の曲情報）
//******************************************************************************

//------------------------------------------------------------------------------
// ヘルプメニューの各画面の先頭に付ける、バルーンの設定
// （メニュー用バルーン、自動スクロール無効、タグを文字として扱う）
//------------------------------------------------------------------------------
□メニューヘッダ
{
	"\0\b[2]\c\![set,autoscroll,disable]\*\_q"
}

//------------------------------------------------------------------------------
// メニューボタン・メニューキーの操作。メニューが出ていれば閉じ、出ていなければ出す
//------------------------------------------------------------------------------
□メニュー
{
	// 既にメニュー表示されてたら消す
	if ○ヘルプメニュー表示中 == 1 {
		○ヘルプメニュー表示中 = 0
		"\0\b[-1]\e"
	}
	else {
		// 表示されてなかったら表示
		□メニュー_index
	}
}

//------------------------------------------------------------------------------
// ヘルプメニューのトップ画面。曲数・演奏状態・キー操作表と、各画面へのリンクを並べる
//------------------------------------------------------------------------------
□メニュー_index
{
	○ヘルプメニュー表示中 = 1
	□メニューヘッダ
	--
	"\v%(menu_bg)"
	--
	if 'for flele'_in_○現在バルーン {
		"\_l[3,2]"
	}
	--
	// 曲インフォ -------------------------
	if ○曲の数 >=1 {
		"現在全%(fcl)%(○曲の数)%(def)曲　"
		--
		if ○演奏中 == 1 {
			//　文字数12を越えたら省略
			_表示曲名 = "%(○演奏中曲名)"
			if ○曲名文字数 > 12 {
				_抜き出し = SUBSTR("%(○演奏中曲名)",0,12)
				_表示曲名 = "%(_抜き出し)…"
			}
			"%(fcl)%(_表示曲名)%(def) 演奏中"
		}
		elseif ○一時停止中 == 1 {
			"%(fcl)一時停止中%(def)"
		}
		else {
			"%(fcl)演奏停止中%(def)"
		}
	}
	else {
		"現在全0曲　"
	}
	--
	if ○現在バルーン=='for flele' {
		"\_l[0,94]"
	}
	elseif ○現在バルーン=='for flele / wide' {
		"\_l[0,110]"
	}
	else {
		'\n\n'
	}
	--
	// キーインフォ -------------------------
	" %(アイコン2('point'))キー操作表 ［\q[コンフィグ,□キー設定_pre]］\n[half]/
		\n　再生 %(fcl)\f[bold,1]%(キー設定表示名(0))\f[bold,default]%(def)　停止/解除 %(fcl)\f[bold,1]%(キー設定表示名(1))\f[bold,default]%(def)/
		\n　Menu %(fcl)\f[bold,1]%(キー設定表示名(2))\f[bold,default]%(def)　曲名ｳｨﾝﾄﾞｳ %(fcl)\f[bold,1]%(キー設定表示名(3))\f[bold,default]%(def)/
		\n　曲クリア %(fcl)\f[bold,1]%(キー設定表示名(4))\f[bold,default]%(def)　終了 %(fcl)\f[bold,1]%(キー設定表示名(5))\f[bold,default]%(def)/
		"

	--
	// 1段目 -------------------------
	"\n\n\n[half]　%(アイコン('info')) \q[説明書,□readme開く]"
	--
	if ○曲の数 >= 1 && ○起動中演奏回 >= 1 {
		"　 　 　 %(アイコン2('music'))\q[演奏中曲情報,□現在曲情報]"
	}
	--

	// 2段目 -------------------------
	"\n　%(アイコン('hotkey')) \q[設定,□設定]"
	--

	"　%(アイコン('fopen')) \q[曲/m3u手動追加,□手動で曲を追加]"
	--

	// 3段目 -------------------------
	"\n　%(アイコン('urldl')) \q[URL入力DL,□URL入力ダウンロード]"
	--
	if ARRAYSIZE(○ダウンロード曲リスト) > 0 {
		"　　%(アイコン('urlfor')) \q[DLした曲を確認,□DL曲のフォルダを開く]"
	}
	--

	// 4段目 -------------------------
	"\n　%(アイコン('clear')) \q[曲リストクリア,□曲リストクリア]　%(アイコン('m3u')) \q[曲リスト出力,□曲リスト出力]"
	--
	// ナビ -------------------------
	"\n\n　　　　　　　　\q[CLOSE,□close]\e"
}

//------------------------------------------------------------------------------
// 説明書（readme.txt）をSSPで開く
//------------------------------------------------------------------------------
□readme開く
{
	"\c\![open,readme]"
	--
	□ヘルプメニュー消滅した
}

//------------------------------------------------------------------------------
// 演奏中の曲の情報を表示する。［RELOAD］で表示し直す
//------------------------------------------------------------------------------
□現在曲情報
{
	○path = ○演奏中曲絶対パス
	○No = ○演奏中曲No
	○イベント名 = "□現在曲情報"
	□メニューヘッダ
	--
	": %(アイコン('music'))演奏中曲情報 ::::::::::\n\n[half]"
	--
	□曲情報中身
	--
	"\n[half]/
		\n　　　　　　 \q[［RELOAD］,□現在曲情報]\n\n[half]/
		\n　　　　　　\q[CLOSE,□close]｜\q[BACK,□メニュー_index]\e"
}

//------------------------------------------------------------------------------
// 曲の情報の本体。○path の曲のタグとファイルの情報を並べる。○No は曲リストでの番号。
// ファイルが無いときは、曲リストに入っているパスだけを示す
//------------------------------------------------------------------------------
□曲情報中身
{
	_path = 絶対パス変換(○path)
	if FATTRIB(_path) == -1 {
		"%(fcl)* ファイルが存在しません *%(def)\n/
			%(fcl)Number　 %(def): %(○No)　( Total %(○曲の数) )\n/
			%(fcl)Filepath %(def): \_!%(○path)\_!\n/
			"
	}
	else {
		_m = □メディア情報(_path)
		"/
			%(fcl)number　 %(def): %(○No)　( Total %(○曲の数) )\n/
			%(fcl)title　　%(def): \_!%(_m[0])\_!\n/
			%(fcl)artist 　%(def): \_!%(_m[1])\_!\n/
			%(fcl)genre 　 %(def): \_!%(_m[3])\_!\n/
			%(fcl)year 　　%(def): \_!%(_m[4])\_!\n/
			%(fcl)filepath %(def): \_!%(_path)\_!\n/
			%(fcl)filesize %(def): %(○現在曲サイズ)\n/
			%(fcl)comment　%(def): \_!%(_m[6])\_!\n/
			"
	}
}

//------------------------------------------------------------------------------
// メニューの［CLOSE］。バルーンを閉じて、歌っているサーフェスにもどす
//------------------------------------------------------------------------------
□close
{
	"\0\b[-1]\w9\w9\w9%(○サーフェス)\e"
	--
	□ヘルプメニュー消滅した
}

//------------------------------------------------------------------------------
// ヘルプメニューが画面から消えたことを覚える（○ヘルプメニュー表示中 を 0 にする）。
// バルーンが閉じられるなど、メニューが消える場面から呼ぶ
//------------------------------------------------------------------------------
□ヘルプメニュー消滅した
{
	○ヘルプメニュー表示中 = 0
}
