//******************************************************************************
// FLELE
// ヘルプメニュー（トップ画面・演奏中の曲情報・設定画面）
//******************************************************************************

//------------------------------------------------------------------------------
// ヘルプメニューの各画面の先頭に付ける、バルーンの設定
// （メニュー用バルーン、自動スクロール無効、タグを文字として扱う）
//------------------------------------------------------------------------------
□メニューヘッダ
{
	"\0\b[2]\c\![set,autoscroll,disable]\*\_q"
}

//------------------------------------------------------------------------------
// メニューボタン・メニューキーの操作。メニューが出ていれば閉じ、出ていなければ出す
//------------------------------------------------------------------------------
□メニュー
{
	// 既にメニュー表示されてたら消す
	if ○ヘルプメニュー表示中 == 1 {
		○ヘルプメニュー表示中 = 0
		"\0\b[-1]\e"
	}
	else {
		// 表示されてなかったら表示
		□メニュー_index
	}
}

//------------------------------------------------------------------------------
// ヘルプメニューのトップ画面。曲数・演奏状態・キー操作表と、各画面へのリンクを並べる
//------------------------------------------------------------------------------
□メニュー_index
{
	○ヘルプメニュー表示中 = 1
	□メニューヘッダ
	--
	"\v%(menu_bg)"
	--
	if 'for flele'_in_○現在バルーン {
		"\_l[3,2]"
	}
	--
	// 曲インフォ -------------------------
	if ○曲の数 >=1 {
		"現在全%(fcl)%(○曲の数)\f[color,default]曲　"
		--
		if ○演奏中 == 1 {
			//　文字数12を越えたら省略
			_表示曲名 = "%(○演奏中曲名)"
			if ○曲名文字数 > 12 {
				_抜き出し = SUBSTR("%(○演奏中曲名)",0,12)
				_表示曲名 = "%(_抜き出し)…"
			}
			"%(fcl)%(_表示曲名)\f[color,default] 演奏中"
		}
		elseif ○一時停止中 == 1 {
			"%(fcl)一時停止中\f[color,default]"
		}
		else {
			"%(fcl)演奏停止中\f[color,default]"
		}
	}
	else {
		"現在全0曲　"
	}
	--
	if ○現在バルーン=='for flele' {
		"\_l[0,94]"
	}
	elseif ○現在バルーン=='for flele / wide' {
		"\_l[0,110]"
	}
	else {
		'\n\n'
	}
	--
	// キーインフォ -------------------------
	" \_b[img\icon_point.png,inline] キー操作表 ［\q[コンフィグ,□キー設定_pre]］\n[half]/
		\n　再生 %(fcl)\f[bold,1]%(キー設定表示名(0))\f[bold,default]\f[color,default]　停止/解除 %(fcl)\f[bold,1]%(キー設定表示名(1))\f[bold,default]\f[color,default]/
		\n　Menu %(fcl)\f[bold,1]%(キー設定表示名(2))\f[bold,default]\f[color,default]　曲名ｳｨﾝﾄﾞｳ %(fcl)\f[bold,1]%(キー設定表示名(3))\f[bold,default]\f[color,default]/
		\n　曲クリア %(fcl)\f[bold,1]%(キー設定表示名(4))\f[bold,default]\f[color,default]　終了 %(fcl)\f[bold,1]%(キー設定表示名(5))\f[bold,default]\f[color,default]/
		"

	--
	// 1段目 -------------------------
	"\n\n\n[half]　\_b[img\icon_info.png,inline] \q[説明書,□readme開く]"
	--
	if ○曲の数 >= 1 && ○起動中演奏回 >= 1 {
		"　 　 　 \_b[img\icon_music.png,inline] \q[演奏中曲情報,□現在曲情報]"
	}
	--

	// 2段目 -------------------------
	"\n　\_b[img\icon_hotkey.png,inline] \q[設定,□設定]"
	--

	"　\_b[img\icon_fopen.png,inline] \q[曲/m3u手動追加,□手動で曲を追加]"
	--

	// 3段目 -------------------------
	"\n　\_b[img\icon_urldl.png,inline] \q[URL入力DL,□URL入力ダウンロード]"
	--
	if ARRAYSIZE(○ダウンロード曲リスト) > 0 {
		"　　\_b[img\icon_urlfor.png,inline] \q[DLした曲を確認,□DL曲のフォルダを開く]"
	}
	--

	// 4段目 -------------------------
	"\n　\_b[img\icon_clear.png,inline] \q[曲リストクリア,□曲リストクリア]　\_b[img\icon_m3u.png,inline] \q[曲リスト出力,□曲リスト出力]"
	--
	// ナビ -------------------------
	"\n\n　　　　　　　　\q[CLOSE,□close]\e"
}

//------------------------------------------------------------------------------
// 説明書（README.md）をSSPで開く
//------------------------------------------------------------------------------
□readme開く
{
	"\c\![open,readme]"
	--
	□ヘルプメニュー消滅した
}

//------------------------------------------------------------------------------
// 演奏中の曲の情報を表示する。［RELOAD］で表示し直す
//------------------------------------------------------------------------------
□現在曲情報
{
	○path = ○演奏中曲絶対パス
	○No = ○演奏中曲No
	○イベント名 = "□現在曲情報"
	□メニューヘッダ
	--
	": \_b[img\icon_music.png,inline]演奏中曲情報 ::::::::::\n\n[half]"
	--
	□曲情報中身
	--
	"\n[half]/
		\n　　　　　　 \q[［RELOAD］,□現在曲情報]\n\n[half]/
		\n　　　　　　\q[CLOSE,□close]｜\q[BACK,□メニュー_index]\e"
}

//------------------------------------------------------------------------------
// 曲の情報の本体。○path の曲のタグとファイルの情報を並べる。○No は曲リストでの番号。
// ファイルが無いときは、曲リストに入っているパスだけを示す
//------------------------------------------------------------------------------
□曲情報中身
{
	_path = 絶対パス変換(○path)
	if FATTRIB(_path) == -1 {
		"%(fcl)* ファイルが存在しません *\f[color,default]\n/
			%(fcl)Number　 \f[color,default]: %(○No)　( Total %(○曲の数) )\n/
			%(fcl)Filepath \f[color,default]: \_!%(○path)\_!\n/
			"
	}
	else {
		_m = □メディア情報(_path)
		"/
			%(fcl)number　 \f[color,default]: %(○No)　( Total %(○曲の数) )\n/
			%(fcl)title　　\f[color,default]: \_!%(_m[0])\_!\n/
			%(fcl)artist 　\f[color,default]: \_!%(_m[1])\_!\n/
			%(fcl)genre 　 \f[color,default]: \_!%(_m[3])\_!\n/
			%(fcl)year 　　\f[color,default]: \_!%(_m[4])\_!\n/
			%(fcl)filepath \f[color,default]: \_!%(_path)\_!\n/
			%(fcl)filesize \f[color,default]: %(○現在曲サイズ)\n/
			%(fcl)comment　\f[color,default]: \_!%(_m[6])\_!\n/
			"
	}
}

//------------------------------------------------------------------------------
// メニューの［CLOSE］。バルーンを閉じて、歌っているサーフェスにもどす
//------------------------------------------------------------------------------
□close
{
	"\0\b[-1]\w9\w9\w9%(○サーフェス)\e"
	--
	□ヘルプメニュー消滅した
}

//------------------------------------------------------------------------------
// ヘルプメニューが画面から消えたことを覚える（○ヘルプメニュー表示中 を 0 にする）。
// バルーンが閉じられるなど、メニューが消える場面から呼ぶ
//------------------------------------------------------------------------------
□ヘルプメニュー消滅した
{
	○ヘルプメニュー表示中 = 0
}

//******************************************************************************
// ヘルプメニューの設定画面（動作設定・再生方法）
//******************************************************************************

//------------------------------------------------------------------------------
// 設定のトップ画面。再生の設定と動作設定へのリンクを並べる
//------------------------------------------------------------------------------
□設定
{
	□メニューヘッダ
	--
	": \_b[img\icon_hotkey.png,inline] 設定 :::::::::::::::::::::::::\n\n"
	--

	"\_b[img\icon_point.png,inline] %(fcl)%(fcc)\q[音楽再生の設定,□再生設定]\f[color,default]\f[cursorfontcolor,default]\n\n[half]"
	--
	"\_b[img\icon_point.png,inline] %(fcl)%(fcc)\q[動作設定,□動作設定]\f[color,default]\f[cursorfontcolor,default]\n\n"
	--

	"\n　　　　　　　\q[CLOSE,□close]｜\q[BACK,□メニュー_index]\e"
}

//------------------------------------------------------------------------------
// 動作設定の画面。ホットキー操作と曲リストメニューのON/OFFを切り替える
//------------------------------------------------------------------------------
□動作設定
{
	□メニューヘッダ
	--
	": \_b[img\icon_hotkey.png,inline] 動作設定 :::::::::::::::::::::\n\n"
	--

	"\_b[img\icon_point.png,inline] インアクティブ時%(fcl)Ctrl + Shift + Key\f[color,default]でキー操作\n\n[half]"
	--
	if ○ホットキー操作=="ON" {
		"　　　　%(fcl)ON\f[color,default] ［\q[変更,□ホットキーOFF]］"
	}
	else {
		"　　　　%(fcl)OFF\f[color,default]［\q[変更,□ホットキーON]］"
	}
	--
	"\n\n\_b[img\icon_point.png,inline] 曲リストメニュー(music list)を出す\n\n[half]"
	--
	if ○曲リストメニュー=="ON" {
		"　　　　%(fcl)ON\f[color,default] ［\q[変更,□曲リストメニューOFF]］"
	}
	else {
		"　　　　%(fcl)OFF\f[color,default]［\q[変更,□曲リストメニューON]］"
	}
	--

	"\n\n[half]/
		\n　　　　　　　\q[CLOSE,□close]｜\q[BACK,□設定]\e"
}

//------------------------------------------------------------------------------
// ホットキー操作をOFFにする。hotkey.dllの登録を解除し、SHIORIを再読み込みして反映する
//------------------------------------------------------------------------------
□ホットキーOFF
{
	○ホットキー操作 = "OFF"
	□ホットキー停止
	--
	"\![reload,shiori]"
	--
	□動作設定
}

//------------------------------------------------------------------------------
// ホットキー操作をONにする。hotkey.dllに登録し、SHIORIを再読み込みして反映する
//------------------------------------------------------------------------------
□ホットキーON
{
	○ホットキー操作 = "ON"
	□ホットキー準備
	--
	"\![reload,shiori]"
	--
	□動作設定
}

//------------------------------------------------------------------------------
// 曲リストメニュー（右クリックで出るメニュー）を使わない設定にする
//------------------------------------------------------------------------------
□曲リストメニューOFF
{
	○曲リストメニュー = "OFF"
	□動作設定
}

//------------------------------------------------------------------------------
// 曲リストメニュー（右クリックで出るメニュー）を使う設定にする
//------------------------------------------------------------------------------
□曲リストメニューON
{
	○曲リストメニュー = "ON"
	□動作設定
}

//------------------------------------------------------------------------------
// 再生方法の画面。［変更］を押すたびに 一度だけ → 同じ曲を繰り返し → ランダム → リスト順に繰り返し → リスト順に一周 の順で切り替える
//------------------------------------------------------------------------------
□再生設定
{
	□メニューヘッダ
	--
	": \_b[img\icon_hotkey.png,inline] 音楽再生の設定 :::::::::::::::\n\n[half]"
	--
	"\_b[img\icon_point.png,inline] 再生方法\n\n[half]"
	--
	case ○演奏法 {
		when "one" {
			"　　 %(fcl)一曲を一度だけ再生\f[color,default]［\q[変更,□演奏法loop]］"
		}
		when "loop" {
			"　　 %(fcl)同じ曲をエンドレス再生\f[color,default]［\q[変更,□演奏法random]］"
		}
		when "seq_loop" {
			"　　 %(fcl)リスト順にエンドレス再生\f[color,default]［\q[変更,□演奏法seq_one]］"
		}
		when "seq_one" {
			"　　 %(fcl)リスト順に一周だけ再生\f[color,default]［\q[変更,□演奏法one]］"
		}
		others {
			"　　 %(fcl)ランダムでエンドレス再生\f[color,default]［\q[変更,□演奏法seq_loop]］"
		}
	}
	--
	"\n\n\n[half]　　　　　　　\q[CLOSE,□close]｜\q[BACK,□設定]\e"
}

//------------------------------------------------------------------------------
// 再生方法を「同じ曲をエンドレス」にする
//------------------------------------------------------------------------------
□演奏法loop
{
	○演奏法 = "loop"
	□再生設定
}

//------------------------------------------------------------------------------
// 再生方法を「ランダムでエンドレス」にする
//------------------------------------------------------------------------------
□演奏法random
{
	○演奏法 = "random"
	□再生設定
}

//------------------------------------------------------------------------------
// 再生方法を「一曲を一度だけ」にする
//------------------------------------------------------------------------------
□演奏法one
{
	○演奏法 = "one"
	□再生設定
}

//------------------------------------------------------------------------------
// 再生方法を「リスト順にエンドレス」にする
//------------------------------------------------------------------------------
□演奏法seq_loop
{
	○演奏法 = "seq_loop"
	□再生設定
}

//------------------------------------------------------------------------------
// 再生方法を「リスト順に一周だけ」にする
//------------------------------------------------------------------------------
□演奏法seq_one
{
	○演奏法 = "seq_one"
	□再生設定
}
